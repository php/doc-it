<sect2 xml:id="reserved.constants.core" xmlns="http://docbook.org/ns/docbook">
 <title>Costanti Predefinite del Core</title>
 <simpara>
  Queste costanti sono definite dal core di PHP. Ciò include PHP,
  lo Zend engine e i moduli SAPI.
 </simpara>
 <variablelist>
  <varlistentry xml:id="constant.php-version">
   <term>
    <constant>PHP_VERSION</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La versione corrente di PHP come stringa nella notazione
     "major.minor.release[extra]".
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-major-version">
   <term>
    <constant>PHP_MAJOR_VERSION</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La versione "major" corrente di PHP come intero (ad es., int(5)
     dalla versione "5.2.7-extra").
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-minor-version">
   <term>
    <constant>PHP_MINOR_VERSION</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La versione "minor" corrente di PHP come intero (ad es., int(2)
     dalla versione "5.2.7-extra").
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-release-version">
   <term>
    <constant>PHP_RELEASE_VERSION</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La versione "release" corrente di PHP come intero (ad es., int(7)
     dalla versione "5.2.7-extra").
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-version-id">
   <term>
    <constant>PHP_VERSION_ID</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La versione corrente di PHP come intero, utile per
     i confronti tra versioni (ad es., int(50207) dalla versione "5.2.7-extra").
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-extra-version">
   <term>
    <constant>PHP_EXTRA_VERSION</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La versione "extra" corrente di PHP come stringa (ad es., '-extra'
     dalla versione "5.2.7-extra"). Spesso utilizzata dai distributori
     per indicare la versione di un pacchetto.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-build-date">
   <term>
    <constant>PHP_BUILD_DATE</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La data e l'ora in cui PHP è stato compilato, nel formato <literal>"M d Y H:i:s"</literal>. Disponibile a partire da PHP 8.5.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-build-provider">
   <term>
    <constant>PHP_BUILD_PROVIDER</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il fornitore che ha compilato PHP. Disponibile a partire da PHP 8.5.0.
    </simpara>
    <note>
     <simpara>
      Questa costante potrebbe non essere disponibile in tutte le build di PHP. (ad es., non è impostata quando
      si compila dai sorgenti senza specificare un valore durante la configurazione).
     </simpara>
    </note>
   </listitem>
  </varlistentry>
  <varlistentry>
   <term>
    <constant xml:id="constant.zend-thread-safe">ZEND_THREAD_SAFE</constant>,
    <constant xml:id="constant.php-zts">PHP_ZTS</constant>
    (<type>bool</type>)
   </term>
   <listitem>
    <simpara>
     Indica se la build corrente di PHP è thread safe.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry>
   <term>
    <constant xml:id="constant.zend-debug-build">ZEND_DEBUG_BUILD</constant>,
    <constant xml:id="constant.php-debug">PHP_DEBUG</constant>
    (<type>bool</type>)
   </term>
   <listitem>
    <simpara>
     Indica se la build corrente di PHP è una build di debug.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.debug-backtrace-provide-object">
   <term>
    <constant>DEBUG_BACKTRACE_PROVIDE_OBJECT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Popola l'indice "object".
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.debug-backtrace-ignore-args">
   <term>
    <constant>DEBUG_BACKTRACE_IGNORE_ARGS</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Non include le informazioni sugli argomenti delle funzioni nello stack trace.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-maxpathlen">
   <term>
    <constant>PHP_MAXPATHLEN</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La lunghezza massima dei nomi di file (incluso il percorso) supportata
     da questa build di PHP.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-os">
   <term>
    <constant>PHP_OS</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il sistema operativo per cui è stato compilato PHP.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-os-family">
   <term>
    <constant>PHP_OS_FAMILY</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La famiglia del sistema operativo per cui è stato compilato PHP. Uno tra
     <literal>'Windows'</literal>, <literal>'BSD'</literal>,
     <literal>'Darwin'</literal>, <literal>'Solaris'</literal>,
     <literal>'Linux'</literal> o <literal>'Unknown'</literal>.
     Disponibile a partire da PHP 7.2.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-sapi">
   <term>
    <constant>PHP_SAPI</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La Server API di questa build di PHP.
     Vedere anche <function>php_sapi_name</function>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-eol">
   <term>
    <constant>PHP_EOL</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il simbolo di 'Fine Riga' corretto per questa piattaforma.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-int-max">
   <term>
    <constant>PHP_INT_MAX</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Il numero intero più grande supportato in questa build di PHP. Solitamente int(2147483647)
     nei sistemi a 32 bit e int(9223372036854775807) nei sistemi a 64 bit.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-int-min">
   <term>
    <constant>PHP_INT_MIN</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Il numero intero più piccolo supportato in questa build di PHP. Solitamente int(-2147483648) nei sistemi a 32 bit e
     int(-9223372036854775808) nei sistemi a 64 bit.
     Solitamente, PHP_INT_MIN === ~PHP_INT_MAX.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-int-size">
   <term>
    <constant>PHP_INT_SIZE</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     La dimensione di un intero in byte in questa build di PHP.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-float-dig">
   <term>
    <constant>PHP_FLOAT_DIG</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Numero di cifre decimali che possono essere arrotondate in un float e viceversa
     senza perdita di precisione.
     Disponibile a partire da PHP 7.2.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-float-epsilon">
   <term>
    <constant>PHP_FLOAT_EPSILON</constant>
    (<type>float</type>)
   </term>
   <listitem>
    <simpara>
     Il più piccolo numero positivo rappresentabile x, tale che <literal>x + 1.0 !=
     1.0</literal>.
     Disponibile a partire da PHP 7.2.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-float-min">
   <term>
    <constant>PHP_FLOAT_MIN</constant>
    (<type>float</type>)
   </term>
   <listitem>
    <simpara>
     Il più piccolo numero in virgola mobile <emphasis>positivo</emphasis> rappresentabile.
     Per ottenere il più piccolo numero in virgola mobile <emphasis>negativo</emphasis> rappresentabile, utilizzare <literal>- PHP_FLOAT_MAX</literal>.
     Disponibile a partire da PHP 7.2.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-float-max">
   <term>
    <constant>PHP_FLOAT_MAX</constant>
    (<type>float</type>)
   </term>
   <listitem>
    <simpara>
     Il più grande numero in virgola mobile rappresentabile.
     Disponibile a partire da PHP 7.2.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.default-include-path">
   <term>
    <constant>DEFAULT_INCLUDE_PATH</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.pear-install-dir">
   <term>
    <constant>PEAR_INSTALL_DIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.pear-extension-dir">
   <term>
    <constant>PEAR_EXTENSION_DIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-extension-dir">
   <term>
    <constant>PHP_EXTENSION_DIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     La directory predefinita in cui cercare le estensioni caricabili dinamicamente
     (a meno che non sia sovrascritta da <link linkend="ini.extension-dir">extension_dir</link>).
     Il valore predefinito è <constant>PHP_PREFIX</constant> (oppure <code>PHP_PREFIX . "\\ext"</code> su Windows).
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-prefix">
   <term>
    <constant>PHP_PREFIX</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il valore impostato per <option role="configure">--prefix</option> durante la configurazione.
     Su Windows, è il valore impostato per <option role="configure">--with-prefix</option>
     durante la configurazione.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-bindir">
   <term>
    <constant>PHP_BINDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il valore impostato per <option role="configure">--bindir</option> durante la configurazione.
     Su Windows, è il valore impostato per <option role="configure">--with-prefix</option>
     durante la configurazione.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-sbindir">
   <term>
    <constant>PHP_SBINDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il valore impostato per <option role="configure">--sbindir</option> durante la configurazione.
     Su Windows, è il valore impostato per <option role="configure">--with-prefix</option>
     durante la configurazione. Disponibile a partire da PHP 8.4.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-binary">
   <term>
    <constant>PHP_BINARY</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Specifica il percorso del binario di PHP durante l'esecuzione dello script.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-mandir">
   <term>
    <constant>PHP_MANDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Specifica dove sono state installate le pagine man.
    </simpara>
    <note>
     <simpara>
      Questa costante non è presente nelle build di PHP per Windows.
     </simpara>
    </note>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-libdir">
   <term>
    <constant>PHP_LIBDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-datadir">
   <term>
    <constant>PHP_DATADIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-sysconfdir">
   <term>
    <constant>PHP_SYSCONFDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-localstatedir">
   <term>
    <constant>PHP_LOCALSTATEDIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-config-file-path">
   <term>
    <constant>PHP_CONFIG_FILE_PATH</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-config-file-scan-dir">
   <term>
    <constant>PHP_CONFIG_FILE_SCAN_DIR</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-shlib-suffix">
   <term>
    <constant>PHP_SHLIB_SUFFIX</constant>
    (<type>string</type>)
   </term>
   <listitem>
    <simpara>
     Il suffisso delle librerie condivise della piattaforma di compilazione, come "so" (la maggior parte degli Unix)
     o "dll" (Windows).
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-fd-setsize">
   <term>
    <constant>PHP_FD_SETSIZE</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Il numero massimo di descrittori di file per le chiamate di sistema select. Disponibile
     a partire da PHP 7.1.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry>
   <term>
    <constant>E_ERROR</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_WARNING</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_PARSE</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_NOTICE</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_CORE_ERROR</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_CORE_WARNING</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_COMPILE_ERROR</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_COMPILE_WARNING</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_USER_ERROR</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_USER_WARNING</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_USER_NOTICE</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_RECOVERABLE_ERROR</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_DEPRECATED</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_USER_DEPRECATED</constant>
    (<type>int</type>)
   </term>
   <term>
    <constant>E_ALL</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <link linkend="errorfunc.constants">Costanti di segnalazione degli errori</link>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry>
   <term>
    <constant>E_STRICT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <link linkend="errorfunc.constants">Costanti di segnalazione degli errori</link>.
     Questa costante non è utilizzata, ed è stata deprecata a partire da PHP 8.4.0.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry>
   <term>
    <constant>__COMPILER_HALT_OFFSET__</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>

    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.true">
   <term>
    &true;
    (<type>bool</type>)
   </term>
   <listitem>
    <simpara>
     Vedere <link linkend="language.types.boolean">Booleani</link>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.false">
   <term>
    &false;
    (<type>bool</type>)
   </term>
   <listitem>
    <simpara>
     Vedere <link linkend="language.types.boolean">Booleani</link>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.null">
   <term>
    &null;
    (<type>null</type>)
   </term>
   <listitem>
    <simpara>
     Vedere <link linkend="language.types.null">Null</link>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-windows-event-ctrl-c">
   <term>
    <constant>PHP_WINDOWS_EVENT_CTRL_C</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Un evento
     <keycombo action="simul">
      <keycap>CTRL</keycap>
      <keycap>C</keycap>
     </keycombo>
     di Windows.
     Disponibile a partire da PHP 7.4.0 (solo Windows).
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-windows-event-ctrl-break">
   <term>
    <constant>PHP_WINDOWS_EVENT_CTRL_BREAK</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Un evento
     <keycombo action="simul">
      <keycap>CTRL</keycap>
      <keycap>BREAK</keycap>
     </keycombo>
     di Windows.
     Disponibile a partire da PHP 7.4.0 (solo Windows).
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.php-cli-process-title">
   <term>
    <constant>PHP_CLI_PROCESS_TITLE</constant>
    (<type>bool</type>)
   </term>
   <listitem>
    <simpara>
     Indica se è disponibile l'impostazione e la lettura del titolo del processo.
     Disponibile solo con la SAPI CLI.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.stderr">
   <term>
    <constant>STDERR</constant>
    (<type>resource</type>)
   </term>
   <listitem>
    <simpara>
     Uno stream già aperto verso <literal>stderr</literal>.
     Disponibile solo con la SAPI CLI.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.stdin">
   <term>
    <constant>STDIN</constant>
    (<type>resource</type>)
   </term>
   <listitem>
    <simpara>
     Uno stream già aperto verso <literal>stdin</literal>.
     Disponibile solo con la SAPI CLI.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.stdout">
   <term>
    <constant>STDOUT</constant>
    (<type>resource</type>)
   </term>
   <listitem>
    <simpara>
     Uno stream già aperto verso <literal>stdout</literal>.
     Disponibile solo con la SAPI CLI.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>
 <simpara>
  Vedere anche: <link linkend="language.constants.magic">Costanti
  magiche</link>.
 </simpara>
</sect2>
