  </varlistentry>

  <varlistentry xml:id="constant.log-news">
   <term>
    <constant>LOG_NEWS</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi del sottosistema news di USENET.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-syslog">
   <term>
    <constant>LOG_SYSLOG</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi generati internamente da <command>syslogd</command>.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-user">
   <term>
    <constant>LOG_USER</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi generici a livello utente.
    </simpara>
