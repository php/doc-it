<refentry xml:id="function.bcsqrt" xmlns="http://docbook.org/ns/docbook" xmlns:xi="http://www.w3.org/2001/XInclude">
 <refnamediv>
  <refname>bcsqrt</refname>
  <refpurpose>Ottiene la radice quadrata di un numero a precisione arbitraria</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>bcsqrt</methodname>
   <methodparam><type>string</type><parameter>num</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>int</type><type>null</type></type><parameter>scale</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <simpara>
   Restituisce la radice quadrata di <parameter>num</parameter>.
  </simpara>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>num</parameter></term>
     <listitem>
      <para>
       L'operando, come stringa numerica BCMath ben formata.
      </para>
     </listitem>
    </varlistentry>
    <xi:include xpointer="function.bcadd..parameters.scale" />
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la radice quadrata come stringa numerica BCMath ben formata.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <para>
   Questa funzione lancia un <classname>ValueError</classname> nei seguenti casi:
   <simplelist>
    <member><parameter>num</parameter> non è una stringa numerica BCMath ben formata</member>
    <member><parameter>num</parameter> è minore di <literal>0</literal></member>
    <member><parameter>scale</parameter> è fuori dall'intervallo valido</member>
   </simplelist>
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Se <parameter>num</parameter> non è una stringa numerica BCMath ben formata,
       o è minore di <literal>0</literal>, viene lanciato un <classname>ValueError</classname>.
       In precedenza veniva invece generato un <constant>E_WARNING</constant>.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>scale</parameter> ora deve essere compreso tra <literal>0</literal>
       e <literal>2147483647</literal>; in precedenza, le scale negative venivano
       trattate silenziosamente come <literal>0</literal>.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>scale</parameter> ora è nullable.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Esempio di <function>bcsqrt</function></title>
   <programlisting role="php">
<![CDATA[
<?php

echo bcsqrt('2', 3); // 1.414

?>
]]>
   </programlisting>
  </example>
 </refsect1>
 
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>bcpow</function></member>
    <member><methodname>BcMath\Number::sqrt</methodname></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
