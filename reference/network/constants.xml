   </term>
   <listitem>
    <simpara>
     Per i messaggi del sottosistema di stampa (line printer).
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-mail">
   <term>
    <constant>LOG_MAIL</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi del sottosistema di posta.
