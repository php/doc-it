<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.array-pop">
 <refnamediv>
  <refname>array_pop</refname>
  <refpurpose>Estrae l'elemento alla fine dell'array</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>mixed</type><methodname>array_pop</methodname>
   <methodparam><type>array</type><parameter role="reference">array</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>array_pop</function> estrae e restituisce il valore
   dell'ultimo elemento di <parameter>array</parameter>, accorciando
   <parameter>array</parameter> di un elemento.
  </para>
  &array.resetspointer;
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>array</parameter></term>
     <listitem>
      <para>
       L'array da cui ottenere il valore.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce il valore dell'ultimo elemento di <parameter>array</parameter>.
   Se <parameter>array</parameter> è vuoto,
   viene restituito &null;.
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>array_pop</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$stack = array("arancia", "banana", "mela", "lampone");
$fruit = array_pop($stack);
print_r($stack);
?>
]]>
    </programlisting>
    <para>
     Dopo questa operazione, <varname>$stack</varname> avrà solo 3 elementi:
    </para>
    <screen role="php">
<![CDATA[
Array
(
    [0] => arancia
    [1] => banana
    [2] => mela
)
]]>
    </screen>
    <para>
     e <literal>lampone</literal> verrà assegnato a
     <varname>$fruit</varname>.
    </para>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>array_push</function></member>
    <member><function>array_shift</function></member>
    <member><function>array_unshift</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

