<refentry xml:id="function.hebrev" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>hebrev</refname>
  <refpurpose>Converte il testo ebraico logico in testo visuale</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>hebrev</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>max_chars_per_line</parameter><initializer>0</initializer></methodparam>
  </methodsynopsis>
  <para>
   Converte il testo ebraico logico in testo visuale.
  </para>
  <para>
   La funzione cerca di evitare di spezzare le parole.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       Una stringa di input in ebraico.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>max_chars_per_line</parameter></term>
     <listitem>
      <para>
       Questo parametro opzionale indica il numero massimo di caratteri per
       riga che verranno restituiti.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la stringa visuale.
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>hebrevc</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
