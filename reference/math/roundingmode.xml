<reference xmlns="http://docbook.org/ns/docbook" xml:id="enum.roundingmode" role="enum">
 <title>L'Enum RoundingMode</title>
 <titleabbrev>RoundingMode</titleabbrev>

 <partintro>
  <section xml:id="enum.roundingmode.intro">
   &reftitle.intro;
   <simpara>
    L'enum <enumname>RoundingMode</enumname> serve a specificare come eseguire
    l'arrotondamento per <function>round</function>,
    <function>bcround</function> e <methodname>BcMath\Number::round</methodname>.
   </simpara>
  </section>

  <section xml:id="enum.roundingmode.synopsis">
   &reftitle.enumsynopsis;

   <enumsynopsis>
    <enumname>RoundingMode</enumname>

    <enumitem>
     <enumidentifier>HalfAwayFromZero</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino.
      Se la parte decimale è <literal>5</literal>,
      arrotonda all'intero con valore assoluto maggiore.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>HalfTowardsZero</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino.
      Se la parte decimale è <literal>5</literal>,
      arrotonda all'intero con valore assoluto minore.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>HalfEven</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino.
      Se la parte decimale è <literal>5</literal>,
      arrotonda all'intero pari.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>HalfOdd</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino.
      Se la parte decimale è <literal>5</literal>,
      arrotonda all'intero dispari.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>TowardsZero</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino con valore assoluto minore o uguale.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>AwayFromZero</enumidentifier>
     <enumitemdescription>
      Arrotonda all'intero più vicino con valore assoluto maggiore o uguale.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>NegativeInfinity</enumidentifier>
     <enumitemdescription>
      Arrotonda al più grande intero minore o uguale.
     </enumitemdescription>
    </enumitem>

    <enumitem>
     <enumidentifier>PositiveInfinity</enumidentifier>
     <enumitemdescription>
      Arrotonda al più piccolo intero maggiore o uguale.
     </enumitemdescription>
    </enumitem>
   </enumsynopsis>
  </section>
 </partintro>
</reference>
