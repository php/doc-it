    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>strtoupper</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$str = "Maria Aveva Un Piccolo Agnello e Lei Lo AMAVA Tanto";
$str = strtoupper($str);
echo $str; // Stampa MARIA AVEVA UN PICCOLO AGNELLO E LEI LO AMAVA TANTO
?>
]]>
    </programlisting>
   </example>   
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  &note.bin-safe;
 </refsect1>

