<refentry xml:id="pdostatement.getattribute" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>PDOStatement::getAttribute</refname>
  <refpurpose>
   Recupera un attributo dello statement
  </refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis role="PDOStatement">
   <modifier>public</modifier> <type>mixed</type><methodname>PDOStatement::getAttribute</methodname>
   <methodparam><type>int</type><parameter>name</parameter></methodparam>
  </methodsynopsis>

  <para>
   Recupera un attributo dello statement. Attualmente non esistono attributi generici, ma solo attributi specifici del driver:
   <itemizedlist>
    <listitem>
     <simpara>
      <constant>PDO::ATTR_CURSOR_NAME</constant>
      (specifico di Firebird e ODBC):
      Recupera il nome del cursore per <literal>UPDATE ... WHERE CURRENT OF</literal>.
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      <constant>Pdo\Pgsql::ATTR_RESULT_MEMORY_SIZE</constant>
      (specifico di PostgreSQL, disponibile a partire da PHP 8.4.0):
      Recupera la quantità di memoria, in byte, allocata per il risultato della query.
     </simpara>
    </listitem>
   </itemizedlist>
   Si noti che gli attributi specifici di un driver <emphasis>non devono</emphasis> essere utilizzati
   con altri driver.
  </para>

 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>name</parameter></term>
     <listitem>
      <para>
       L'attributo da interrogare.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce il valore dell'attributo.
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><methodname>PDO::getAttribute</methodname></member>
    <member><methodname>PDO::setAttribute</methodname></member>
    <member><methodname>PDOStatement::setAttribute</methodname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
