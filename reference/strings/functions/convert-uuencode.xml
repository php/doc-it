<refentry xml:id="function.convert-uuencode" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>convert_uuencode</refname>
  <refpurpose>Codifica una stringa con uuencode</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>convert_uuencode</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>convert_uuencode</function> codifica una stringa utilizzando l'algoritmo
   uuencode.
  </para>
  <para>
   Uuencode traduce tutte le stringhe (inclusi i dati binari) in caratteri
   stampabili, rendendole sicure per la trasmissione in rete. I dati codificati con uuencode sono
   circa il 35% più grandi dell'originale.
  </para>
  <note>
   <simpara>
    <function>convert_uuencode</function> non produce né la riga <literal>begin</literal>
    né la riga <literal>end</literal>, che fanno parte dei <emphasis>file</emphasis> codificati con uuencode.
   </simpara>
  </note> 
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       I dati da codificare.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce i dati codificati con uuencode.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
