<!ENTITY trader.arg.slowk.ma.type 'Tipo di media mobile per la Slow-K. Si dovrebbe usare la serie di costanti <link xmlns="http://docbook.org/ns/docbook" linkend="trader.constants">TRADER_MA_TYPE_*</link>.'>
<!ENTITY trader.arg.signal.ma.type 'Tipo di media mobile per la linea del segnale. Si dovrebbe usare la serie di costanti <link xmlns="http://docbook.org/ns/docbook" linkend="trader.constants">TRADER_MA_TYPE_*</link>.'>
<!ENTITY trader.arg.nbdevup 'Moltiplicatore di deviazione per la banda superiore. Intervallo valido da <link xmlns="http://docbook.org/ns/docbook" linkend="constant.trader-real-min">TRADER_REAL_MIN</link> a <link xmlns="http://docbook.org/ns/docbook" linkend="constant.trader-real-max">TRADER_REAL_MAX</link>.'>
