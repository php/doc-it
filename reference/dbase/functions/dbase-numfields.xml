<refentry xml:id="function.dbase-numfields" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>dbase_numfields</refname>
  <refpurpose>Ottiene il numero di campi di un database</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>dbase_numfields</methodname>
   <methodparam><type>resource</type><parameter>database</parameter></methodparam>
  </methodsynopsis>
  <para>
   Ottiene il numero di campi (colonne) del database specificato.
  </para>
  <note>
   <para>
    I numeri dei campi sono compresi tra 0 e <literal>dbase_numfields($db)-1</literal>,
    mentre i numeri dei record sono compresi tra 1 e <literal>dbase_numrecords($db)</literal>.
   </para>
  </note>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>database</parameter></term>
     <listitem>
      <para>
       La risorsa del database, restituita da <function>dbase_open</function>
       o da <function>dbase_create</function>.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Il numero di campi del database, oppure &false; se si verifica un errore.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>PECL dbase 7.0.0</entry>
      <entry>
       <parameter>database</parameter> ora è una <type>resource</type>
       invece di un <type>int</type>.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>dbase_numfields</function></title>
    <programlisting role="php">
<![CDATA[
<?php

$rec = dbase_get_record($db, $recno);
$nf  = dbase_numfields($db);
for ($i = 0; $i < $nf; $i++) {
  echo $rec[$i], "\n";
}

?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>dbase_numrecords</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

