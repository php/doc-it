<refentry xml:id="function.password-get-info" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>password_get_info</refname>
  <refpurpose>Restituisce informazioni sull'hash indicato</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>array</type><methodname>password_get_info</methodname>
   <methodparam><type>string</type><parameter>hash</parameter></methodparam>
  </methodsynopsis>
  <para>
   Quando riceve un hash valido creato da un algoritmo supportato da
   <function>password_hash</function>, questa funzione restituisce un array di
   informazioni su tale hash.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <variablelist>
   <varlistentry>
    <term><parameter>hash</parameter></term>
    <listitem>
     <para>
      &password.parameter.hash;
     </para>
    </listitem>
   </varlistentry>
  </variablelist>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce un array associativo con tre elementi:
   <itemizedlist>
    <listitem>
     <simpara>
       <literal>algo</literal>, che corrisponde a una
       <link linkend="password.constants">costante di algoritmo di password</link>
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      <literal>algoName</literal>, che contiene il nome leggibile
      dell'algoritmo
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      <literal>options</literal>, che include le opzioni
      fornite durante la chiamata a <function>password_hash</function>
     </simpara>
    </listitem>
   </itemizedlist>
  </para>
 </refsect1>
</refentry>

