<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.filemtime">
 <refnamediv>
  <refname>filemtime</refname>
  <refpurpose>Ottiene l'ora di modifica del file</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>int</type><type>false</type></type><methodname>filemtime</methodname>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
  </methodsynopsis>
  <para>
   Questa funzione restituisce l'ora in cui sono stati scritti i blocchi di dati
   di un file, ovvero l'ora in cui il contenuto del file è stato modificato.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>filename</parameter></term>
     <listitem>
      <para>
       Percorso del file.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce l'ora dell'ultima modifica del file&return.falseforfailure;.
   L'ora viene restituita come timestamp Unix, adatto
   alla funzione <function>date</function>.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  &fs.emits.warning.on.failure;
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>filemtime</function></title>
    <programlisting role="php">
<![CDATA[
<?php
// visualizza ad esempio:  somefile.txt è stato modificato l'ultima volta il: December 29 2002 22:16:23.

$filename = 'somefile.txt';
if (file_exists($filename)) {
    echo "$filename è stato modificato l'ultima volta il: " . date ("F d Y H:i:s.", filemtime($filename));
}
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  &note.filesystem-time-res;
  &note.clearstatcache;
  &tip.fopen-wrapper.stat;
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>filectime</function></member>
    <member><function>stat</function></member>
    <member><function>touch</function></member>
    <member><function>getlastmod</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

