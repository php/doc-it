<refentry xml:id="function.token-name" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>token_name</refname>
  <refpurpose>Restituisce il nome simbolico di un dato token PHP</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>token_name</methodname>
   <methodparam><type>int</type><parameter>id</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>token_name</function> restituisce il nome simbolico per un valore
   <parameter>id</parameter> di token PHP. 
  </para>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>id</parameter></term>
     <listitem>
      <para>
       Il valore del token.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Il nome simbolico del valore <parameter>id</parameter> fornito.
  </para>
 </refsect1>
 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>token_name</function></title>
    <programlisting role="php">
<![CDATA[
<?php
// 260 è il valore del token T_EVAL
echo token_name(260);        // -> "T_EVAL"

// una costante di token corrisponde al proprio nome
echo token_name(T_FUNCTION); // -> "T_FUNCTION"
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><link linkend="tokens">Elenco dei token del parser</link></member>
   <member><function>PhpToken::getTokenName</function></member>
  </simplelist>
 </refsect1>
</refentry>
