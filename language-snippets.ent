<!-- IMAP notes -->

<!ENTITY imap.changelog.imap-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>imap</parameter> ora si aspetta un&apos;istanza di <classname>IMAP\Connection</classname>;
  in precedenza, era prevista una &resource; <literal>imap</literal> valida.
 </entry>
</row>'>

<!ENTITY imap.imap-parameter.imap '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>imap</parameter></term><listitem><simpara>Un&apos;istanza di <classname>IMAP\Connection</classname>.</simpara></listitem></varlistentry>'>

<!-- Deprecated -->

<!ENTITY imap.pattern '<simpara xmlns="http://docbook.org/ns/docbook">Specifica da dove, nella gerarchia delle mailbox,
cominciare a cercare.</simpara><simpara xmlns="http://docbook.org/ns/docbook">Ci sono due caratteri speciali che è possibile
passare all&apos;interno di <parameter>pattern</parameter>:
&apos;<literal>*</literal>&apos; e &apos;<literal>&#37;</literal>&apos;.
&apos;<literal>*</literal>&apos; restituisce tutte le mailbox. Se si passa
<parameter>pattern</parameter> come &apos;<literal>*</literal>&apos;, si
otterrà un elenco dell&apos;intera gerarchia delle mailbox.
&apos;<literal>&#37;</literal>&apos;
restituisce solo il livello attuale.
&apos;<literal>&#37;</literal>&apos; come parametro <parameter>pattern</parameter>
restituirà solo le mailbox del livello
superiore; &apos;<literal>~/mail/&#37;</literal>&apos; su <literal>UW_IMAPD</literal> restituirà ogni mailbox nella directory <filename>~/mail</filename>, ma nessuna nelle sottocartelle di tale directory.</simpara>'>

<!ENTITY imap.mailboxname.insecure '<warning xmlns="http://docbook.org/ns/docbook"><simpara>
Passare dati non attendibili a questo parametro <emphasis>non è sicuro</emphasis>, a meno che
<link linkend="ini.imap.enable-insecure-rsh">imap.enable_insecure_rsh</link> non sia disabilitato.
</simpara></warning>'>

<!-- intl notes -->

<!ENTITY intl.parameter.intl-calendar '<simpara xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>IntlCalendar</classname>.</simpara>'>

<!ENTITY intl.error.intl-calendar '<simpara xmlns="http://docbook.org/ns/docbook">In caso di fallimento viene restituito anche &false;. Per rilevare le condizioni di errore usare <function>intl_get_error_code</function>, oppure impostare Intl in modo che lanci <link linkend="ini.intl.use-exceptions">eccezioni</link>.</simpara>'>

<!ENTITY intl.codepoint.parameter '<simpara xmlns="http://docbook.org/ns/docbook">Il valore <type>int</type> del code point (ad es. <literal>0x2603</literal> per <emphasis>U+2603 SNOWMAN</emphasis>), oppure il carattere codificato come <type>string</type> UTF-8 (ad es. <literal>"\u{2603}"</literal>)</simpara>'>

<!ENTITY intl.codepoint.return '<simpara xmlns="http://docbook.org/ns/docbook">Il tipo restituito è <type>int</type> a meno che il code point non sia stato passato come <type>string</type> UTF-8, nel qual caso viene restituita una <type>string</type>. Restituisce &null; in caso di fallimento.</simpara>'>

<!ENTITY intl.codepoint.example 'Test di code point differenti'>

<!ENTITY intl.locale-len.return '<simpara xmlns="http://docbook.org/ns/docbook">Restituisce &null; quando la lunghezza di <parameter>locale</parameter> supera <constant>INTL_MAX_LOCALE_LEN</constant>.</simpara>'>

<!ENTITY intl.property.parameter '<simpara xmlns="http://docbook.org/ns/docbook">La proprietà Unicode da cercare (si vedano le costanti <constant>IntlChar::PROPERTY_<replaceable>*</replaceable></constant>).</simpara>'>

<!ENTITY intl.property.example 'Test di proprietà differenti'>

<!ENTITY intl.param.grapheme.locale '<simpara>Locale da utilizzare.</simpara>'>

<!ENTITY intl.changelog.grapheme.locale '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.5.0</entry>
 <entry>
  È stato aggiunto il parametro opzionale <parameter>locale</parameter>.
 </entry>
</row>'>

<!-- LDAP notes -->

<!ENTITY ldap.parameter.ldap 'Un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">LDAP\Connection</classname>, restituita da <function xmlns="http://docbook.org/ns/docbook">ldap_connect</function>.'>

<!ENTITY ldap.parameter.result 'Un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">LDAP\Result</classname>, restituita da <function xmlns="http://docbook.org/ns/docbook">ldap_list</function> o <function xmlns="http://docbook.org/ns/docbook">ldap_search</function>.'>

<!ENTITY ldap.parameter.entry 'Un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">LDAP\ResultEntry</classname>.'>

<!ENTITY ldap.warn.control-paged '<warning xmlns="http://docbook.org/ns/docbook">
 <simpara>
  Questa funzione è stata <emphasis>DEPRECATA</emphasis> a partire da PHP 7.4.0 e <emphasis>RIMOSSA</emphasis> a partire da PHP 8.0.0.
  Al suo posto si dovrebbe usare il parametro <parameter>controls</parameter> di <function>ldap_search</function>.
  Per i dettagli si veda anche <link linkend="ldap.controls">Controlli LDAP</link>.
 </simpara>
</warning>'>

<!ENTITY ldap.changelog.controls-nullable '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>controls</parameter> ora è nullable; in precedenza, il valore predefinito era <literal>[]</literal>.
 </entry>
</row>'>

<!ENTITY ldap.changelog.ldap-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>ldap</parameter> ora si aspetta un&apos;istanza di <classname>LDAP\Connection</classname>;
  in precedenza, era prevista una &resource; <literal>ldap link</literal> valida.
 </entry>
</row>'>

<!ENTITY ldap.changelog.entry-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>entry</parameter> ora si aspetta un&apos;istanza di <classname>LDAP\ResultEntry</classname>;
  in precedenza, era prevista una &resource; <literal>ldap result entry</literal> valida.
 </entry>
</row>'>

<!ENTITY ldap.changelog.result-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>result</parameter> ora si aspetta un&apos;istanza di <classname>LDAP\Result</classname>;
  in precedenza, era prevista una &resource; <literal>ldap result</literal> valida.
 </entry>
</row>'>

<!ENTITY ldap.changelog.return-result-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Ora restituisce un&apos;istanza di <classname>LDAP\Result</classname>;
  in precedenza, veniva restituita una &resource;.
 </entry>
</row>'>

<!ENTITY ldap.changelog.return-result-entry-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Ora restituisce un&apos;istanza di <classname>LDAP\ResultEntry</classname>;
  in precedenza, veniva restituita una &resource;.
 </entry>
</row>'>

<!ENTITY ldap.return-result 'Restituisce un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">LDAP\Result</classname>,&return.falseforfailure;.'>
<!ENTITY ldap.return-result-array 'Restituisce un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">LDAP\Result</classname>, un array di istanze di <classname xmlns="http://docbook.org/ns/docbook">LDAP\Result</classname>,&return.falseforfailure;.'>

<!ENTITY ldap.return-result-array-info '<simpara xmlns="http://docbook.org/ns/docbook">È anche possibile effettuare ricerche parallele. In questo caso, il primo argomento dovrebbe essere un array di
istanze di <classname>LDAP\Connection</classname>, anziché una singola istanza.
Se le ricerche non devono usare tutte lo stesso DN di base e lo stesso filtro, è possibile passare invece come argomenti un array di DN di base e/o un array di filtri.
Questi array devono avere la stessa dimensione dell&apos;array di istanze di <classname>LDAP\Connection</classname>,
poiché i primi elementi degli array vengono usati per una ricerca, i secondi per un&apos;altra, e così via.
Quando si effettuano ricerche parallele viene restituito un array di istanze di <classname>LDAP\Result</classname>, tranne in caso di errore, quando il valore restituito sarà &false;.</simpara>'>

<!-- mbstring notes -->

<!ENTITY note.mbstring.encoding.internal '<note xmlns="http://docbook.org/ns/docbook"><simpara>La codifica interna o la
codifica dei caratteri specificata da <function>mb_regex_encoding</function>
sarà utilizzata come codifica dei caratteri per questa funzione.</simpara></note>'>

<!ENTITY note.mbstring.encoding.current '<note xmlns="http://docbook.org/ns/docbook"><simpara>La
codifica dei caratteri specificata da <function>mb_regex_encoding</function>
sarà utilizzata come codifica dei caratteri predefinita per questa funzione.</simpara></note>'>

<!ENTITY mbstring.encoding.parameter '<simpara xmlns="http://docbook.org/ns/docbook">Il parametro <parameter>encoding</parameter>
è la codifica dei caratteri. Se è omesso o &null;, verrà utilizzata la codifica
interna dei caratteri.</simpara>'>

<!ENTITY mbstring.warning.e-modifier '<warning xmlns="http://docbook.org/ns/docbook"><simpara>Non utilizzare mai il modificatore <literal>e</literal> quando si lavora con input non attendibile. Non verrà effettuato alcun escaping automatico (come avviene con <function>preg_replace</function>). Non prestare attenzione a questo aspetto molto probabilmente creerà vulnerabilità di esecuzione remota di codice nell&apos;applicazione.</simpara></warning>'>

<!ENTITY mbstring.changelog.encoding-nullable '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>encoding</parameter> ora è nullable.
 </entry>
</row>'>

<!ENTITY mbstring.changelog.needle-empty '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>needle</parameter> ora accetta una stringa vuota.
 </entry>
</row>'>

<!ENTITY mbstring.errors.encoding-invalid '<para xmlns="http://docbook.org/ns/docbook">
 A partire da PHP 8.0.0, viene lanciato un <exceptionname>ValueError</exceptionname> se
 <parameter>encoding</parameter> è una codifica non valida.
 Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
</para>'>

<!ENTITY mbstring.changelog.encoding-invalid '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  Ora lancia un <exceptionname>ValueError</exceptionname> se
  <parameter>encoding</parameter> è una codifica non valida.
  In precedenza, veniva emesso un <constant>E_WARNING</constant>
  e veniva restituito &false;.
 </entry>
</row>'>

<!-- mcrypt notes -->

<!ENTITY mcrypt.parameter.cipher '<simpara xmlns="http://docbook.org/ns/docbook">Una tra le costanti <constant>MCRYPT_ciphername</constant>, oppure il nome dell&apos;algoritmo sotto forma di stringa.</simpara>'>

<!ENTITY mcrypt.parameter.iv.strict '<simpara xmlns="http://docbook.org/ns/docbook">Utilizzato per l&apos;inizializzazione nelle modalità CBC, CFB, OFB e in alcuni algoritmi in modalità STREAM. Se la dimensione dell&apos;IV fornito non è supportata dalla modalità di concatenamento, oppure se non è stato fornito alcun IV ma la modalità di concatenamento lo richiede, la funzione emetterà un warning e restituirà &false;.</simpara>'>

<!ENTITY mcrypt.parameter.mode '<simpara xmlns="http://docbook.org/ns/docbook">Una tra le costanti <constant>MCRYPT_MODE_modename</constant>, oppure una tra le seguenti stringhe: "ecb", "cbc", "cfb", "ofb", "nofb" o "stream".</simpara>'>

<!-- memcached notes -->

<!ENTITY memcached.note.delete-time '<note xmlns="http://docbook.org/ns/docbook"><simpara>
       A partire da memcached 1.3.0 (rilasciato nel 2009) questa funzionalità non è più
       supportata. Passare un valore di <parameter>time</parameter> diverso da zero causerà
       il fallimento della cancellazione. <methodname>Memcached::getResultCode</methodname>
       restituirà <constant>MEMCACHED_INVALID_ARGUMENTS</constant>.
      </simpara></note>
'>

<!ENTITY memcached.parameter.expiration 'Il tempo di scadenza, il valore predefinito è 0. Vedere <link
 linkend="memcached.expiration" xmlns="http://docbook.org/ns/docbook">Tempi di Scadenza</link> per ulteriori informazioni.'>

<!ENTITY memcached.parameter.server_key 'La chiave che identifica il server su cui salvare il valore o da cui recuperarlo. Invece di effettuare l&apos;hashing sulla chiave effettiva dell&apos;elemento, si effettua l&apos;hashing della chiave del server al momento di decidere con quale server memcached comunicare. Questo permette di raggruppare gli elementi correlati su un singolo server, ottenendo maggiore efficienza nelle operazioni multiple.'>

<!ENTITY memcached.parameter.items 'Un array di coppie chiave/valore da salvare sul server.'>

<!ENTITY memcached.parameter.key 'La chiave in cui salvare il valore.'>

<!ENTITY memcached.parameter.value 'Il valore da salvare.'>

<!ENTITY memcached.result.getresultcode 'Utilizzare <methodname xmlns="http://docbook.org/ns/docbook">Memcached::getResultCode</methodname> se necessario.'>

<!ENTITY memcached.result.delete-multi '<simpara xmlns="http://docbook.org/ns/docbook">
   Restituisce un array indicizzato da <parameter>keys</parameter>. Ogni elemento
   è &true; se la chiave corrispondente è stata cancellata, oppure una delle
   costanti <constant>Memcached::RES_<replaceable>*</replaceable></constant> se la cancellazione corrispondente
   è fallita.
   </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   Il metodo <methodname>Memcached::getResultCode</methodname> restituirà
   il codice di risultato dell&apos;ultima operazione di cancellazione eseguita, ovvero la cancellazione
   relativa all&apos;ultimo elemento di <parameter>keys</parameter>.
  </simpara>
'>

<!-- password notes -->

<!ENTITY password.parameter.algo 'Una <link xmlns="http://docbook.org/ns/docbook" linkend="password.constants">costante per l&apos;algoritmo della password</link> che stabilisce l&apos;algoritmo da utilizzare quando si effettua l&apos;hashing della password.'>

<!ENTITY password.parameter.hash 'Un hash creato da <function xmlns="http://docbook.org/ns/docbook">password_hash</function>.'>

<!ENTITY password.parameter.options 'Un array associativo contenente le opzioni. Si vedano le <link xmlns="http://docbook.org/ns/docbook" linkend="password.constants">costanti per l&apos;algoritmo della password</link> per la documentazione sulle opzioni supportate da ciascun algoritmo.'>

<!ENTITY password.parameter.password 'La password dell&apos;utente.'>

