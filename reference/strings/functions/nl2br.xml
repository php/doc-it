<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.nl2br">
 <refnamediv>
  <refname>nl2br</refname>
  <refpurpose>Inserisce le interruzioni di riga HTML prima di tutti i ritorni a capo di una stringa</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>nl2br</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
   <methodparam choice="opt"><type>bool</type><parameter>use_xhtml</parameter><initializer>&true;</initializer></methodparam>
  </methodsynopsis>
  <para>
   Restituisce <parameter>string</parameter> con <code>&lt;br /&gt;</code> o
   <code>&lt;br&gt;</code> inserito prima di tutti i ritorni a capo (<literal>\r\n</literal>,
   <literal>\n\r</literal>, <literal>\n</literal> e <literal>\r</literal>).
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       La stringa in input.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>use_xhtml</parameter></term>
     <listitem>
      <para>
       Indica se utilizzare o meno interruzioni di riga compatibili con XHTML.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la stringa modificata.
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Uso di <function>nl2br</function></title>
    <programlisting role="php">
<![CDATA[
<?php
echo nl2br("foo non è\n bar");
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
foo non è<br />
 bar
]]>
    </screen>
   </example>
   <example>
    <title>Generazione di markup HTML valido tramite il parametro <parameter>use_xhtml</parameter></title>
    <programlisting role="php">
<![CDATA[
<?php
echo nl2br("Benvenuto\r\nQuesto è il mio documento HTML", false);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Benvenuto<br>
Questo è il mio documento HTML
]]>
    </screen>
   </example>
   <example>
    <title>Vari separatori di ritorno a capo</title>
    <programlisting role="php">
<![CDATA[
<?php
$string = "Questa\r\nè\n\runa\nstringa\r";
echo nl2br($string);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
Questa<br />
è<br />
una<br />
stringa<br />
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>htmlspecialchars</function></member>
    <member><function>htmlentities</function></member>
    <member><function>wordwrap</function></member>
    <member><function>str_replace</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
