 <variablelist>
  <title>
   Valori di <parameter>priority</parameter> disponibili per
   <function>syslog</function>
  </title>

  <simpara>
   Le costanti di priorità sono elencate dai messaggi urgenti a quelli di debug.
  </simpara>

  <varlistentry xml:id="constant.log-emerg">
   <term>
    <constant>LOG_EMERG</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Emergenza, il sistema è inutilizzabile.
     Corrisponde a una condizione di panico.
     Solitamente inviato in broadcast a tutti i processi.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-alert">
   <term>
    <constant>LOG_ALERT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Allarme, è richiesto un intervento immediato.
     Ad esempio, un database di sistema danneggiato.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-crit">
   <term>
    <constant>LOG_CRIT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Critico, è richiesto un intervento.
     Ad esempio, errori dei dispositivi hardware.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-err">
   <term>
    <constant>LOG_ERR</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Messaggi di errore.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-warning">
   <term>
    <constant>LOG_WARNING</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Messaggi di avviso.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-notice">
   <term>
    <constant>LOG_NOTICE</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Messaggi di notifica, corrispondono a condizioni che non sono condizioni di errore,
     ma che potrebbero richiedere una gestione particolare.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-info">
   <term>
    <constant>LOG_INFO</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Messaggi informativi.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-debug">
   <term>
    <constant>LOG_DEBUG</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Messaggi di debug che contengono informazioni normalmente utili solo durante
     il debug di un programma.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>

 <variablelist>
  <title>
   Valori di <parameter>type</parameter> disponibili per
   <function>dns_get_record</function>
  </title>


  <varlistentry xml:id="constant.dns-any">
   <term>
    <constant>DNS_ANY</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Qualsiasi record di risorsa (Resource Record).
     Sulla maggior parte dei sistemi restituisce tutti i record di risorsa,
     tuttavia, a causa di stranezze nel comportamento di
     <literal>libresolv</literal> tra le varie piattaforme, ciò non è garantito.
    </simpara>
    <simpara>
     Il più lento <constant>DNS_ALL</constant> raccoglierà tutti i record in modo più affidabile.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-all">
   <term>
    <constant>DNS_ALL</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Interroga iterativamente il name server per ogni tipo di record disponibile.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-a">
   <term>
    <constant>DNS_A</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa indirizzo IPv4.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-aaaa">
   <term>
    <constant>DNS_AAAA</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa indirizzo IPv6.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-a6">
   <term>
    <constant>DNS_A6</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Definito come parte delle prime versioni di IPv6, ma declassato a storico dalla
     <link xlink:href="&url.rfc;6563">RFC 6563</link>.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-caa">
   <term>
    <constant>DNS_CAA</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa Certification Authority Authorization.
     Disponibile a partire da PHP 7.0.16 e 7.1.2.
    </simpara>
    <warning>
     <simpara>
      Non disponibile su Windows.
     </simpara>
    </warning>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-cname">
   <term>
    <constant>DNS_CNAME</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa alias (Canonical Name).
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-hinfo">
   <term>
    <constant>DNS_HINFO</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa informazioni sull'host (Host Info).
     Per ulteriori spiegazioni e per il significato di questi valori, visitare la pagina IANA sui
     <link xlink:href="&url.iana.system-names;">nomi dei sistemi operativi</link>.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-mx">
   <term>
    <constant>DNS_MX</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa di scambio della posta (Mail Exchanger).
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-naptr">
   <term>
    <constant>DNS_NAPTR</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Puntatore all'autorità di denominazione (Naming Authority Pointer).
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-ns">
   <term>
    <constant>DNS_NS</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa name server autoritativo.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-ptr">
   <term>
    <constant>DNS_PTR</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa puntatore.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-soa">
   <term>
    <constant>DNS_SOA</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa di inizio dell'autorità (Start of Authority).
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-srv">
   <term>
    <constant>DNS_SRV</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Localizzatore di servizi.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.dns-txt">
   <term>
    <constant>DNS_TXT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Risorsa di testo.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>

