<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.session-decode">
 <refnamediv>
  <refname>session_decode</refname>
  <refpurpose>Decodifica i dati di sessione da una stringa di sessione codificata</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>session_decode</methodname>
   <methodparam><type>string</type><parameter>data</parameter></methodparam>
  </methodsynopsis>
  <simpara>
   <function>session_decode</function> decodifica i dati di sessione serializzati forniti in
   <parameter>data</parameter> e popola la superglobale $_SESSION
   con il risultato.
  </simpara>
  <para>
   Per impostazione predefinita, il metodo di deserializzazione usato è interno a PHP e non è lo stesso di <function>unserialize</function>.
   Il metodo di serializzazione può essere impostato tramite <link linkend="ini.session.serialize-handler">session.serialize_handler</link>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>data</parameter></term>
     <listitem>
      <para>
       I dati codificati da memorizzare.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.success;
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>session_encode</function></member>
    <member><link linkend="ini.session.serialize-handler">session.serialize_handler</link></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

