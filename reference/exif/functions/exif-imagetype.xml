       </entry>
      </row>
     </tbody>
    </tgroup>
   </informaltable>
  </refsect1>

  <refsect1 role="examples">
   &reftitle.examples;
   <example>
    <title>Esempio di uso di <function>exif_imagetype</function></title>
    <programlisting role="php">
<![CDATA[
<?php
if (exif_imagetype('image.gif') != IMAGETYPE_GIF) {
    echo 'The picture is not a gif';
}
?>
]]>
    </programlisting>
   </example>
  </refsect1>
  <refsect1 role="seealso">
   &reftitle.seealso;
