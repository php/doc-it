<!ENTITY odbc.connection.id '<simpara xmlns="http://docbook.org/ns/docbook">L&apos;oggetto di connessione ODBC,
vedere <function>odbc_connect</function> per ulteriori dettagli.</simpara>'>

<!ENTITY odbc.result.object 'L&apos;oggetto risultato ODBC'>

<!ENTITY odbc.result.object-return 'Restituisce un oggetto risultato ODBC'>

<!ENTITY odbc.result.object-return-falseforfailure '&odbc.result.object-return;&return.falseforfailure;.'>

<!ENTITY odbc.parameter.catalog 'Il catalogo (&apos;qualifier&apos; nella terminologia di ODBC 2).'>

<!ENTITY odbc.parameter.schema 'Lo schema (&apos;owner&apos; nella terminologia di ODBC 2).'>

<!ENTITY odbc.parameter.search 'Questo parametro accetta i seguenti modelli di ricerca:
<literal xmlns="http://docbook.org/ns/docbook">&#x25;</literal> per trovare zero o più caratteri,
e <literal xmlns="http://docbook.org/ns/docbook">_</literal> per trovare un singolo carattere.'>

<!ENTITY odbc.result.driver-specific 'I driver possono riportare colonne aggiuntive.'>

<!ENTITY odbc.changelog.connection-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  <parameter>odbc</parameter> ora si aspetta un&apos;istanza di <classname>Odbc\Connection</classname>;
  in precedenza, era prevista una <type>resource</type>.
 </entry>
</row>'>

<!ENTITY odbc.changelog.connection-return '<row xmlns="http://docbook.org/ns/docbook">
  <entry>8.4.0</entry>
  <entry>
   Questa funzione ora restituisce un&apos;istanza di <classname>Odbc\Connection</classname>;
   in precedenza, veniva restituita una <type>resource</type>.
  </entry>
 </row>'>

<!ENTITY odbc.changelog.credential-params '<row xmlns="http://docbook.org/ns/docbook">
  <entry>8.4.0</entry>
  <entry>
   <parameter>user</parameter> e <parameter>password</parameter> ora sono nullable,
   e ora sono anche opzionali con valore predefinito &null;.
  </entry>
 </row>
 <row xmlns="http://docbook.org/ns/docbook">
  <entry>8.4.0</entry>
  <entry>
   In precedenza, usando una stringa vuota per <parameter>password</parameter> non veniva incluso
   <literal>pwd</literal> nella stringa di connessione generata per <parameter>dsn</parameter>.
   Ora viene generata in modo da includere un <literal>pwd</literal> con una stringa vuota come valore.
   Per ripristinare il comportamento precedente, ora è possibile impostare <parameter>password</parameter> a &null;.
  </entry>
 </row>
 <row xmlns="http://docbook.org/ns/docbook">
  <entry>8.4.0</entry>
  <entry>
   In precedenza, se <parameter>dsn</parameter> conteneva <literal>uid</literal> o <literal>pwd</literal>,
   entrambi i parametri <parameter>user</parameter> e <parameter>password</parameter> venivano ignorati.
   Ora <parameter>user</parameter> viene ignorato solo se <parameter>dsn</parameter> contiene
   <literal>uid</literal>, e <parameter>password</parameter> viene ignorato solo se
   <parameter>dsn</parameter> contiene <literal>pwd</literal>.
  </entry>
 </row>'>

<!ENTITY odbc.changelog.result-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  <parameter>statement</parameter> ora si aspetta un&apos;istanza di <classname>Odbc\Result</classname>;
  in precedenza, era prevista una <type>resource</type>.
 </entry>
</row>'>

<!ENTITY odbc.changelog.result-return '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  Questa funzione ora restituisce un&apos;istanza di <classname>Odbc\Result</classname>;
  in precedenza, veniva restituita una <type>resource</type>.
 </entry>
</row>'>

<!-- OAUTH -->
<!ENTITY oauth.callback.error 'Emette un errore di livello <constant xmlns="http://docbook.org/ns/docbook">E_ERROR</constant>
se la funzione di callback non può essere chiamata, oppure se non è stata specificata.'>

<!ENTITY oauth.changelog.error.null 'In precedenza restituiva &null; in caso di fallimento, invece di &false;.'>

<!-- Oracle -->
<!ENTITY oci.db "<simpara xmlns='http://docbook.org/ns/docbook' xmlns:xlink='http://www.w3.org/1999/xlink'>Contiene
l&apos;<literal>istanza Oracle</literal> a cui connettersi. Può essere
una <link xlink:href='&url.oracle.oic.connect;'>stringa Easy
Connect</link>, oppure un Connect Name dal
file <filename>tnsnames.ora</filename>, o il nome di un&apos;istanza
Oracle locale.
</simpara>
<simpara xmlns='http://docbook.org/ns/docbook'>Se non specificato o &null;, PHP usa
variabili d&apos;ambiente come <constant>TWO_TASK</constant> (su Linux)
o <constant>LOCAL</constant> (su Windows)
e <constant>ORACLE_SID</constant> per determinare
l&apos;<literal>istanza Oracle</literal> a cui connettersi.
</simpara>
<simpara xmlns='http://docbook.org/ns/docbook'>
Per utilizzare il metodo di denominazione Easy Connect, PHP deve essere linkato con le librerie Client di Oracle
10<emphasis>g</emphasis> o successive. La stringa Easy Connect per Oracle
10<emphasis>g</emphasis> ha la forma:
<emphasis>[//]host_name[:port][/service_name]</emphasis>. A partire da Oracle
11<emphasis>g</emphasis>, la sintassi è:
<emphasis>[//]host_name[:port][/service_name][:server_type][/instance_name]</emphasis>.
Con Oracle 19c sono state introdotte ulteriori opzioni, tra cui le impostazioni di timeout e
keep-alive. Fare riferimento alla documentazione di Oracle. I nomi dei servizi possono essere trovati eseguendo
l&apos;utility di Oracle <literal>lsnrctl status</literal> sulla macchina
del server del database.
</simpara>
<simpara xmlns='http://docbook.org/ns/docbook'>
Il file <filename>tnsnames.ora</filename> può trovarsi nel percorso di ricerca di Oracle Net,
che
include <filename>/your/path/to/instantclient/network/admin</filename>, <filename>$ORACLE_HOME/network/admin</filename>
e <filename>/etc</filename>. In alternativa, impostare <literal>TNS_ADMIN</literal>
in modo che venga letto <filename>$TNS_ADMIN/tnsnames.ora</filename>. Assicurarsi che il daemon
web abbia accesso in lettura al file.
</simpara>">

<!ENTITY oci.charset "<simpara xmlns='http://docbook.org/ns/docbook'>Determina
il set di caratteri utilizzato dalle librerie Client di Oracle. Non è necessario che il set
di caratteri corrisponda a quello usato dal database. Se
non corrisponde, Oracle farà del suo meglio per convertire i dati da e verso
il set di caratteri del database. A seconda dei set di caratteri, ciò potrebbe
non dare risultati utilizzabili. La conversione richiede inoltre del tempo aggiuntivo.
</simpara>
<simpara xmlns='http://docbook.org/ns/docbook'>Se non specificato, le
librerie Client di Oracle determinano un set di caratteri dalla
variabile d&apos;ambiente <constant>NLS_LANG</constant>.
</simpara>
<simpara xmlns='http://docbook.org/ns/docbook'>Fornire questo parametro può
ridurre il tempo necessario per la connessione.
</simpara>">

<!ENTITY oci.sessionmode '<simpara xmlns="http://docbook.org/ns/docbook">Questo
parametro è disponibile a partire da PHP 5 (PECL OCI8 1.1) e accetta i
seguenti valori: <constant>OCI_DEFAULT</constant>,
<constant>OCI_SYSOPER</constant> e <constant>OCI_SYSDBA</constant>.
Se viene specificato <constant>OCI_SYSOPER</constant> o
<constant>OCI_SYSDBA</constant>, questa funzione tenterà
di stabilire una connessione privilegiata usando credenziali esterne.
Le connessioni privilegiate sono disabilitate per impostazione predefinita. Per abilitarle
occorre impostare <link linkend="ini.oci8.privileged-connect">oci8.privileged_connect</link>
a <literal>On</literal>.
</simpara>
<simpara xmlns="http://docbook.org/ns/docbook">
PHP 5.3 (PECL OCI8 1.3.4) ha introdotto il valore di modalità
<constant>OCI_CRED_EXT</constant>. Questo indica a Oracle di usare
l&apos;autenticazione esterna o del sistema operativo, che deve essere configurata nel
database. Il flag <constant>OCI_CRED_EXT</constant> può essere usato solo
con il nome utente &quot;/&quot; e una password vuota.
<link linkend="ini.oci8.privileged-connect">oci8.privileged_connect</link>
può essere <literal>On</literal> oppure <literal>Off</literal>.
</simpara>
<simpara xmlns="http://docbook.org/ns/docbook">
<constant>OCI_CRED_EXT</constant> può essere combinato con le modalità
<constant>OCI_SYSOPER</constant> o
<constant>OCI_SYSDBA</constant>.
</simpara>
<simpara xmlns="http://docbook.org/ns/docbook">
<constant>OCI_CRED_EXT</constant> non è supportato su Windows per
ragioni di sicurezza.
</simpara>'>

<!ENTITY oci.datatypes '<simpara xmlns="http://docbook.org/ns/docbook">Per dettagli sulla mappatura dei tipi di dato effettuata
dall&apos;estensione OCI8, vedere i <link linkend="oci8.datatypes">tipi di dato
supportati dal driver</link></simpara>'>

<!ENTITY oci.parameter.connection '<simpara xmlns="http://docbook.org/ns/docbook">Un identificativo di connessione Oracle,
restituito da <function>oci_connect</function>, <function>oci_pconnect</function>,
o <function>oci_new_connect</function>.</simpara>'>

<!ENTITY oci.availability.note.10g '<note xmlns="http://docbook.org/ns/docbook"><title>Requisito di versione di Oracle</title>
<simpara>Questa funzione è disponibile quando PHP è linkato con le librerie di Oracle Database
dalla versione 10<emphasis>g</emphasis> in poi.</simpara></note>'>

<!ENTITY oci.clientinfo.tip '<tip xmlns="http://docbook.org/ns/docbook"><title>Prestazioni</title><simpara>Con le versioni precedenti di
OCI8 o di Oracle Database, le informazioni del client possono essere impostate utilizzando il package
<literal>DBMS_APPLICATION_INFO</literal> di Oracle. Ciò è meno efficiente che
usare <function>oci_set_client_info</function>.</simpara></tip>'>

<!ENTITY oci.roundtrip.caution '<caution xmlns="http://docbook.org/ns/docbook"><title>Attenzione ai round-trip</title>
<simpara>Alcune funzioni OCI8, ma non tutte, causano round-trip. I round-trip verso il
database possono non verificarsi con le query quando il caching dei risultati è abilitato.
</simpara></caution>'>

<!ENTITY oci.use.setprefetch '<simpara xmlns="http://docbook.org/ns/docbook">Per
le query che restituiscono un grande numero di righe, le prestazioni possono essere
migliorate significativamente
aumentando <link linkend="ini.oci8.default-prefetch">oci8.default_prefetch</link>
o usando <function>oci_set_prefetch</function>.
</simpara>'>

<!ENTITY oci.arg.statement.id
"<simpara xmlns='http://docbook.org/ns/docbook'>Un identificativo valido di
statement OCI8 creato da <function>oci_parse</function> ed eseguito
da <function>oci_execute</function>, o un identificativo di statement <literal>REF
CURSOR</literal>.</simpara>">

<!-- PCNTL Notes -->
<!ENTITY pcntl.parameter.status '<simpara xmlns="http://docbook.org/ns/docbook">Il parametro <parameter>status</parameter>
è il parametro di stato fornito a una chiamata
riuscita a <function>pcntl_waitpid</function>.</simpara>'>

<!-- PS Notes -->
<!ENTITY ps.note.visible '<simpara xmlns="http://docbook.org/ns/docbook">L&apos;annotazione non sarà visibile se il documento
è stampato o visualizzato, ma verrà mostrata se il documento è convertito in
pdf da Acrobat Distiller™ o Ghostview.</simpara>'>

<!ENTITY note.open-basedir.func '<note xmlns="http://docbook.org/ns/docbook"><simpara>Questa funzione è influenzata da <link
linkend="ini.open-basedir">open_basedir</link>.</simpara></note>'>

<!ENTITY note.language-construct '<note xmlns="http://docbook.org/ns/docbook"><simpara>Poiché questo è un
costrutto del linguaggio e non una funzione, non può essere chiamato usando le
<link linkend="functions.variable-functions">variabili funzione</link>
o gli <link linkend="functions.named-arguments">argomenti nominali</link>.</simpara>
</note>'>

<!-- Common pieces in partintro-sections -->
<!ENTITY no.config '<simpara xmlns="http://docbook.org/ns/docbook">Questa estensione non definisce alcuna direttiva di configurazione in &php.ini;.</simpara>'>
<!ENTITY no.requirement '<simpara xmlns="http://docbook.org/ns/docbook">Non sono necessarie librerie esterne per compilare questa estensione.</simpara>'>
<!ENTITY no.install '<simpara xmlns="http://docbook.org/ns/docbook">Non è necessaria alcuna installazione per usare queste
funzioni; fanno parte del core di PHP.</simpara>'>

