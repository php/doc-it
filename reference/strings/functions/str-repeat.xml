<refentry xml:id="function.str-repeat" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>str_repeat</refname>
  <refpurpose>Ripete una stringa</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>str_repeat</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
   <methodparam><type>int</type><parameter>times</parameter></methodparam>
  </methodsynopsis>
  <para>
   Restituisce <parameter>string</parameter> ripetuta
   <parameter>times</parameter> volte.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       La stringa da ripetere.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>times</parameter></term>
     <listitem>
      <simpara>
       Numero di volte in cui la stringa <parameter>string</parameter> deve essere
       ripetuta.
      </simpara>
      <para>
       <parameter>times</parameter> deve essere maggiore o uguale a 0.
       Se <parameter>times</parameter> vale 0, la funzione
       restituirà una stringa vuota.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la stringa ripetuta.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lancia un <exceptionname>ValueError</exceptionname> se <parameter>times</parameter>
   è minore di <literal>0</literal>.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Ora lancia un <exceptionname>ValueError</exceptionname> se <parameter>times</parameter>
       è minore di <literal>0</literal>.
       In precedenza, veniva emesso un <constant>E_WARNING</constant> e veniva restituito &null;.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>str_repeat</function></title>
    <programlisting role="php">
<![CDATA[
<?php
echo str_repeat("-=", 10);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
-=-=-=-=-=-=-=-=-=-=
]]>
    </screen>
   </example>   
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><link linkend="control-structures.for">for</link></member>
    <member><function>str_pad</function></member>
    <member><function>substr_count</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
