<refentry xml:id="function.posix-ttyname" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>posix_ttyname</refname>
  <refpurpose>Determina il nome del dispositivo terminale</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>string</type><type>false</type></type><methodname>posix_ttyname</methodname>
   <methodparam><type class="union"><type>resource</type><type>int</type></type><parameter>file_descriptor</parameter></methodparam>
  </methodsynopsis>
  <para>
   Restituisce una <type>string</type> con il percorso assoluto del dispositivo
   terminale corrente aperto sul descrittore di file
   <parameter>file_descriptor</parameter>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    &posix.parameter.fd;
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   In caso di successo, restituisce una <type>string</type> con il percorso assoluto di
   <parameter>file_descriptor</parameter>. In caso di fallimento, restituisce &false;
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <para>
   Per valori interi non validi di <parameter>file_descriptor</parameter>
   viene generato un <constant>E_WARNING</constant>.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.5.0</entry>
      <entry>
       <varname>last_error</varname> ora viene impostato a <constant>EBADF</constant>
       quando viene incontrato un <parameter>file_descriptor</parameter> non valido.
      </entry>
     </row>
     <row>
      <entry>8.3.0</entry>
      <entry>
       Ora vengono emessi <constant>E_WARNING</constant> per gli errori di tipo nelle coercizioni
       a intero, secondo la consueta semantica di coercizione dei tipi di PHP.
      </entry>
     </row>
     <row>
      <entry>8.3.0</entry>
      <entry>
       Per valori interi non validi di <parameter>file_descriptor</parameter>
       ora viene generato un <constant>E_WARNING</constant>.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>posix_isatty</function></member>
    <member><function>stream_isatty</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
