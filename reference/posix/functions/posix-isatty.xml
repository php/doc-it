<refentry xml:id="function.posix-isatty" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>posix_isatty</refname>
  <refpurpose>Determina se un descrittore di file è un terminale interattivo</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>posix_isatty</methodname>
   <methodparam><type class="union"><type>resource</type><type>int</type></type><parameter>file_descriptor</parameter></methodparam>
  </methodsynopsis>
   <para>
    Determina se il descrittore di file <parameter>file_descriptor</parameter> fa riferimento a un dispositivo
    di tipo terminale valido.
  </para>
 </refsect1>
    
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    &posix.parameter.fd;
   </variablelist>
  </para>
 </refsect1>
       
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce &true; se <parameter>file_descriptor</parameter> è un descrittore aperto connesso
   a un terminale e &false; altrimenti.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.5.0</entry>
      <entry>
       Ora emette un <constant>E_WARNING</constant> quando viene incontrato un
       <parameter>file_descriptor</parameter> non valido.
      </entry>
     </row>
     <row>
      <entry>8.4.0</entry>
      <entry>
       Imposta errno (numero di errore) a <constant>EBADF</constant> quando il
       descrittore di file/stream passato non è valido.
      </entry>
     </row>
     <row>
      <entry>8.3.0</entry>
      <entry>
       Ora vengono emessi <constant>E_WARNING</constant> per gli errori di tipo nelle coercizioni
       a intero, secondo la consueta semantica di coercizione dei tipi di PHP.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>
       
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>posix_ttyname</function></member>
    <member><function>stream_isatty</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
