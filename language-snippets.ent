<!ENTITY seealso.array.sorting 'Il <link xmlns="http://docbook.org/ns/docbook" linkend="array.sorting">confronto delle funzioni di ordinamento degli array</link>'>

<!ENTITY sort.flags.parameter '<varlistentry xmlns="http://docbook.org/ns/docbook">
  <term><parameter>flags</parameter></term>
  <listitem>
   <simpara>
    Il secondo parametro opzionale <parameter>flags</parameter>
    può essere usato per modificare il comportamento dell&apos;ordinamento usando questi valori:
   </simpara>
   <para>
    Flag del tipo di ordinamento:
    <itemizedlist>
     <listitem>
      <simpara><constant>SORT_REGULAR</constant> - confronta gli elementi normalmente;
      i dettagli sono descritti nella sezione sugli <link linkend="language.operators.comparison">operatori di confronto</link></simpara>
     </listitem>
     <listitem>
      <simpara><constant>SORT_NUMERIC</constant> - confronta gli elementi numericamente</simpara>
     </listitem>
     <listitem>
      <simpara><constant>SORT_STRING</constant> - confronta gli elementi come stringhe</simpara>
     </listitem>
     <listitem>
      <simpara>
       <constant>SORT_LOCALE_STRING</constant> - confronta gli elementi come
       stringhe, in base al locale corrente. Usa il locale,
       che può essere modificato usando <function>setlocale</function>
      </simpara>
     </listitem>
     <listitem>
      <simpara>
       <constant>SORT_NATURAL</constant> - confronta gli elementi come stringhe
       usando un "ordinamento naturale" come <function>natsort</function>
      </simpara>
     </listitem>
     <listitem>
      <simpara>
       <constant>SORT_FLAG_CASE</constant> - può essere combinato
       (con OR bit a bit) con
       <constant>SORT_STRING</constant> o
       <constant>SORT_NATURAL</constant> per ordinare le stringhe senza distinzione tra maiuscole e minuscole
      </simpara>
     </listitem>
    </itemizedlist>
   </para>
  </listitem>
 </varlistentry>
'>

<!ENTITY sort.callback.description '<simpara xmlns="http://docbook.org/ns/docbook">
 &return.callbacksort;
</simpara>
&callback.cmp;
<caution xmlns="http://docbook.org/ns/docbook">
 <simpara>
  Restituire valori <emphasis>non interi</emphasis> dalla funzione di
  confronto, come <type>float</type>, comporterà un cast interno a
  <type>int</type> del valore restituito dal callback. Quindi valori come
  <literal>0.99</literal> e <literal>0.1</literal> verranno entrambi convertiti nel
  valore intero <literal>0</literal>, e tali valori risulteranno uguali nel confronto.
 </simpara>
</caution>'>

<!ENTITY sort.callback.description.presort '<caution xmlns="http://docbook.org/ns/docbook">
 <para>
  Il callback di ordinamento deve gestire qualsiasi valore di qualsiasi array in qualsiasi ordine,
  indipendentemente dall&apos;ordine in cui sono stati forniti originariamente.
  Questo perché ogni singolo array viene prima ordinato e poi confrontato con gli altri array.

  Per esempio:
  <programlisting role="php">
<![CDATA[
<?php
$arrayA = ["string", 1];
$arrayB = [["value" => 1]];
// $item1 e $item2 possono essere uno qualsiasi tra "string", 1 o ["value" => 1]
$compareFunc = static function ($item1, $item2) {
    $value1 = is_string($item1) ? strlen($item1) : (is_array($item1) ? $item1["value"] : $item1);
    $value2 = is_string($item2) ? strlen($item2) : (is_array($item2) ? $item2["value"] : $item2);
    return $value1 <=> $value2;
};
?>
]]>
  </programlisting>
 </para>
</caution>'>

<!ENTITY ini.shorthandbytes '<simpara xmlns="http://docbook.org/ns/docbook">Quando viene usato un <type>int</type>, il
