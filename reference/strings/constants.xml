             </listitem>
             <listitem>
              <simpara>
               Restituisce 2 se la stringa del segno segue la quantità e <constant>CURRENCY_SYMBOL</constant>.
              </simpara>
             </listitem>
             <listitem>
              <simpara>
               Restituisce 3 se la stringa del segno precede immediatamente <constant>CURRENCY_SYMBOL</constant>.
              </simpara>
             </listitem>
             <listitem>
              <simpara>
               Restituisce 4 se la stringa del segno segue immediatamente <constant>CURRENCY_SYMBOL</constant>.
              </simpara>
             </listitem>
            </itemizedlist>
    </para>
   </listitem>
  </varlistentry>
