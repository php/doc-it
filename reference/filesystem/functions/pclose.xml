<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.pclose">
 <refnamediv>
  <refname>pclose</refname>
  <refpurpose>Chiude il puntatore al file di un processo</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>pclose</methodname>
   <methodparam><type>resource</type><parameter>handle</parameter></methodparam>
  </methodsynopsis>
  <para>
   Chiude un puntatore al file di una pipe aperta da <function>popen</function>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>handle</parameter></term>
     <listitem>
      <para>
       Il puntatore al file deve essere valido e deve essere stato restituito da una
       chiamata riuscita a <function>popen</function>.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce lo stato di terminazione del processo che è stato eseguito. In caso di
   errore viene restituito <literal>-1</literal>.
  </para>
  &note.sigchild;
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>pclose</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$handle = popen('/bin/ls', 'r');
pclose($handle);
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <title>Solo Unix:</title>
   <para>
    <function>pclose</function> è implementata internamente usando la
    chiamata di sistema <literal>waitpid(3)</literal>. Per ottenere il vero codice di
    stato di uscita, la funzione <function>pcntl_wexitstatus</function>
    deve essere usata.
   </para>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>popen</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

