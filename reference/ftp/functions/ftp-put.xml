<refentry xml:id="function.ftp-put" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>ftp_put</refname>
  <refpurpose>Carica un file sul server FTP</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>ftp_put</methodname>
   <methodparam><type>FTP\Connection</type><parameter>ftp</parameter></methodparam>
   <methodparam><type>string</type><parameter>remote_filename</parameter></methodparam>
   <methodparam><type>string</type><parameter>local_filename</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>mode</parameter><initializer><constant>FTP_BINARY</constant></initializer></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>offset</parameter><initializer>0</initializer></methodparam>
  </methodsynopsis>
  <para>
   <function>ftp_put</function> memorizza un file locale sul server FTP.
  </para>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>ftp</parameter></term>
     <listitem>
       &ftp.parameter.ftp;
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>remote_filename</parameter></term>
     <listitem>
      <para>
       Il percorso del file remoto.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>local_filename</parameter></term>
     <listitem>
      <para>
       Il percorso del file locale.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>mode</parameter></term>
     <listitem>
      <para>
       La modalità di trasferimento. Deve essere <constant>FTP_ASCII</constant> oppure
       <constant>FTP_BINARY</constant>.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>offset</parameter></term>
     <listitem>
      <para>La posizione nel file remoto da cui iniziare il caricamento.</para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.success;
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  &ext.ftp.mode-valueerror;
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     &ftp.changelog.ftp-param;
     &ext.ftp.changelog.mode-valueerror;
     <row>
      <entry>7.3.0</entry>
      <entry>
       Il parametro <parameter>mode</parameter> ora è opzionale. In precedenza
       era obbligatorio.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>ftp_put</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$file = 'somefile.txt';
$remote_file = 'readme.txt';

// stabilisce la connessione di base
$ftp = ftp_connect($ftp_server);

// si collega con nome utente e password
$login_result = ftp_login($ftp, $ftp_user_name, $ftp_user_pass);

// carica un file
if (ftp_put($ftp, $remote_file, $file, FTP_ASCII)) {
 echo "$file caricato correttamente\n";
} else {
 echo "Si è verificato un problema durante il caricamento di $file\n";
}

// chiude la connessione
ftp_close($ftp);
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
