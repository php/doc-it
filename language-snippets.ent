<!-- XML snippets -->
<!ENTITY xml.parser.param '<varlistentry xmlns="http://docbook.org/ns/docbook">
 <term><parameter>parser</parameter></term>
 <listitem>
  <simpara>
   Il parser XML.
  </simpara>
 </listitem>
</varlistentry>'>

<!ENTITY xml.handler.description '<para xmlns="http://docbook.org/ns/docbook">
 Se viene passato &null;, il gestore viene reimpostato al suo stato predefinito.
 <warning>
  <simpara>
    Anche una stringa vuota reimposta il gestore,
    tuttavia questo è deprecato a partire da PHP 8.4.0.
  </simpara>
 </warning>
</para>
<simpara xmlns="http://docbook.org/ns/docbook">
 Se <parameter>handler</parameter> è un <type>callable</type>,
 il callable viene impostato come gestore.
</simpara>
<para xmlns="http://docbook.org/ns/docbook">
 Se <parameter>handler</parameter> è una <type>string</type>,
 può essere il nome di un metodo di un oggetto impostato con
 <function>xml_set_object</function>.
 <warning>
  <simpara>
   Questo è deprecato a partire da PHP 8.4.0.
  </simpara>
 </warning>
</para>
<warning xmlns="http://docbook.org/ns/docbook">
 <simpara>
  A partire da PHP 8.4.0, la validità del callable viene verificata quando si imposta il gestore,
  non quando viene chiamato.
  Ciò significa che <function>xml_set_object</function> deve essere chiamata prima di
  impostare una stringa di metodo come callback.
  Tuttavia, poiché anche questo comportamento è deprecato a partire da PHP 8.4.0,
  si raccomanda invece di usare un <type>callable</type> appropriato per il metodo.
 </simpara>
</warning>
'>

<!ENTITY xml.handler.parser.param '<varlistentry xmlns="http://docbook.org/ns/docbook">
 <term><parameter>parser</parameter></term>
 <listitem>
  <simpara>
   Il parser XML che chiama il gestore.
  </simpara>
 </listitem>
</varlistentry>'>

<!ENTITY xml.changelog.handler-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  Passare un valore non <type>callable</type> di tipo <type>string</type> a
  <parameter>handler</parameter> è ora deprecato,
  usare un callable appropriato per i metodi, oppure &null; per reimpostare il gestore.
 </entry>
</row>
<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  La validità di <parameter>handler</parameter> come <type>callable</type>
  viene ora verificata quando si imposta il gestore invece che quando lo si chiama.
 </entry>
</row>'>

<!ENTITY xml.changelog.parser-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>parser</parameter> ora si aspetta un&apos;istanza di <classname>XMLParser</classname>;
  in precedenza, era prevista una risorsa <literal>xml</literal> valida di tipo <type>resource</type>.
 </entry>
</row>'>

<!-- Migration Guide snippets -->
<!ENTITY migration56.openssl.peer-verification '
   <simpara xmlns="http://docbook.org/ns/docbook">
    Tutti gli stream client cifrati ora abilitano la verifica del peer per impostazione predefinita. Per
    impostazione predefinita, verrà usato il bundle CA predefinito di OpenSSL per verificare il certificato
    del peer. Nella maggior parte dei casi, non sarà necessario apportare modifiche per comunicare
    con server dotati di certificati SSL validi, poiché i distributori generalmente
    configurano OpenSSL per usare bundle CA noti e affidabili.
   </simpara>

   <simpara xmlns="http://docbook.org/ns/docbook">
    Il bundle CA predefinito può essere sovrascritto a livello globale impostando
    l&apos;opzione di configurazione openssl.cafile oppure openssl.capath, o per
    singola richiesta usando le opzioni
    <link linkend="context.ssl.cafile"><parameter>cafile</parameter></link> o
    <link linkend="context.ssl.capath"><parameter>capath</parameter></link>
    del contesto.
   </simpara>

   <simpara xmlns="http://docbook.org/ns/docbook">
    Sebbene in generale non sia raccomandato, è possibile disabilitare la verifica
    del certificato del peer per una richiesta impostando l&apos;opzione di contesto
    <link linkend="context.ssl.verify-peer"><parameter>verify_peer</parameter></link>
    a &false;, e disabilitare la validazione del nome del peer impostando
    l&apos;opzione di contesto <link linkend="context.ssl.verify-peer-name"><parameter>verify_peer_name</parameter></link>
    a &false;.
   </simpara>
'>

<!-- Sodium -->
<!ENTITY sodium.changelog.aes256gcm-aarch64 '
  <informaltable xmlns="http://docbook.org/ns/docbook">
   <tgroup cols="2">
