<refentry xml:id="function.session-save-path" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>session_save_path</refname>
  <refpurpose>Ottiene e/o imposta il percorso di salvataggio della sessione corrente</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>string</type><type>false</type></type><methodname>session_save_path</methodname>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>path</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <para>
   <function>session_save_path</function> restituisce il percorso della directory
   corrente usata per salvare i dati di sessione.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>path</parameter></term>
     <listitem>
      <para>
       Percorso dei dati di sessione. Se specificato e non &null;, il percorso in cui vengono salvati i dati
       verrà cambiato. A tale scopo, occorre chiamare <function>session_save_path</function>
       prima di <function>session_start</function>.
      </para>
      <para>
       <note>
        <para>
         Su alcuni sistemi operativi, può essere utile specificare un percorso su un
         filesystem che gestisca in modo efficiente molti file di piccole dimensioni.
        </para>
       </note>
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce il percorso della directory corrente usata per la memorizzazione dei dati&return.falseforfailure;.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>path</parameter> ora è nullable.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member>
     La direttiva di configurazione
     <link linkend="ini.session.save-path">session.save_path</link>
    </member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
