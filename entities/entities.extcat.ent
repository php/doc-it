<?xml version="1.0" encoding="utf-8"?>
<!-- EN-Revision: 6a1e42bcba9133ba0579636a85c77753092e1d8d Maintainer: pastore Status: ready -->
<!--

Entità per la lista categorizzata delle estensioni.

-->

<entities xmlns       = "http://docbook.org/ns/docbook"
          translate   = "yes">

<entity name="extcat.alphabetical"><title>Alfabetico</title></entity>

<entity name="extcat.intro">
 <title>Lista/Classificazione delle estensioni</title>
 <simpara>
  Questa appendice classifica più di 150 estensioni documentate nel
  Manuale PHP secondo diversi criteri.
 </simpara>
</entity>

<entity name="extcat.membership"><title>Appartenenza</title></entity>

<entity name="extcat.membership.bundled">
 <title>Estensioni incluse</title>
 <simpara>Queste estensioni sono incluse in PHP.</simpara>
</entity>

<entity name="extcat.membership.core">
 <title>Estensioni del nucleo</title>
 <simpara>
  Queste non sono delle vere estensioni. Fanno parte del nucleo di PHP
  e non possono essere escluse da un binario PHP con le opzioni di compilazione.
 </simpara>
</entity>

<entity name="extcat.membership.external">
 <title>Estensioni esterne</title>
 <simpara>
  Queste estensioni sono incluse in PHP ma, per
  compilarle, sono necessarie delle librerie esterne.
 </simpara>
</entity>

<entity name="extcat.membership.pecl">
 <title>Estensioni PECL</title>
 <simpara>
  Queste estensioni sono disponibili su &link.pecl;. Possono
  richiedere librerie esterne. Esistono altre estensioni PECL, ma
  non sono ancora documentate nel manuale PHP.
 </simpara>
</entity>

<entity name="extcat.state">
 <title>Stato</title>
 <simpara>
  Questa parte elenca le estensioni non destinate all'uso in produzione —
  sono troppo "vecchie" (deprecate) o troppo "nuove" (sperimentali).
 </simpara>
</entity>

<entity name="extcat.state.deprecated">
 <title>Estensioni deprecate</title>
 <simpara>
  Queste estensioni sono state deprecate, in genere in favore di
  altre estensioni.
 </simpara>
</entity>

<entity name="extcat.state.experimental">
 <title>Estensioni sperimentali</title>
 <simpara>
  Il comportamento di queste estensioni — compresi i nomi delle loro
  funzioni e tutto ciò che è documentato su queste estensioni —
  può cambiare senza preavviso in un futuro rilascio di PHP. Utilizzare queste
  estensioni a proprio rischio.
 </simpara>
</entity>

</entities>
