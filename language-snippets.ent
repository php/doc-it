<!ENTITY gd.constants.png-filter '<simpara xmlns="http://docbook.org/ns/docbook">
    Un filtro PNG speciale, usato dalla funzione <function>imagepng</function>.
</simpara>'>

<!ENTITY gd.constants.flip '<simpara xmlns="http://docbook.org/ns/docbook">
    Usata insieme a <function>imageflip</function>, disponibile a partire da PHP 5.5.0.
</simpara>'>

<!ENTITY gd.constants.interpolation '<simpara xmlns="http://docbook.org/ns/docbook">
    Usata insieme a <function>imagesetinterpolation</function>, disponibile a partire da PHP 5.5.0.
</simpara>'>

<!ENTITY gd.deprecated.gd-formats '<warning xmlns="http://docbook.org/ns/docbook"><simpara>I formati di immagine
GD e GD2 sono formati di immagine proprietari di libgd. Devono essere considerati
<emphasis>obsoleti</emphasis>, e dovrebbero essere usati solo a scopo di sviluppo e
test.</simpara></warning>'>

<!ENTITY gd.changelog.image-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>image</parameter> ora si aspetta un&apos;istanza di <classname>GdImage</classname>;
  in precedenza, era attesa una <type>resource</type> <literal>gd</literal> valida.
 </entry>
</row>'>

<!-- CSV -->
<!ENTITY warning.csv.escape-parameter '<warning xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink"><simpara>
 Quando <parameter>escape</parameter> è impostato su qualcosa di diverso da una stringa vuota
 (<literal>""</literal>), può produrre un CSV non conforme alla
 <link xlink:href="&url.rfc;4180">RFC 4180</link> o che non sopravvive a un ciclo di scrittura e rilettura
 tramite le funzioni CSV di PHP. Il valore predefinito di <parameter>escape</parameter> è
 <literal>"\\"</literal>, quindi si raccomanda di impostarlo esplicitamente alla stringa vuota.
 Il valore predefinito cambierà in una versione futura di PHP, non prima di PHP 9.0.
</simpara></warning>'>

<!-- JSON notes -->

<!ENTITY json.implementation.superset '
 <note xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
  <simpara>
   PHP implementa un superset di JSON come specificato nella
   <link xlink:href="&url.rfc;7159">RFC 7159</link> originale.
  </simpara>
 </note>
'>

