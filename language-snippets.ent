<!ENTITY extension.runtime '<simpara xmlns="http://docbook.org/ns/docbook">
Il comportamento di queste funzioni è influenzato dalle impostazioni di &php.ini;.
</simpara>'>

<!ENTITY ini.php.constants 'Per maggiori dettagli e definizioni sulle
modalità INI_*, vedere <xref xmlns="http://docbook.org/ns/docbook" linkend="configuration.changes.modes"/>.'>

