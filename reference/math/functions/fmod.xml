<refentry xml:id="function.fmod" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>fmod</refname>
  <refpurpose>Restituisce il resto in virgola mobile (modulo) della divisione
  degli argomenti</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>float</type><methodname>fmod</methodname>
   <methodparam><type>float</type><parameter>num1</parameter></methodparam>
   <methodparam><type>float</type><parameter>num2</parameter></methodparam>
  </methodsynopsis>
  <para>
   Restituisce il resto in virgola mobile della divisione del dividendo
   (<parameter>num1</parameter>) per il divisore (<parameter>num2</parameter>).
   Il resto (<varname>r</varname>) è definito come: num1 = i * num2 + r, per
   un certo intero <varname>i</varname>. Se <parameter>num2</parameter> è
   diverso da zero, <varname>r</varname> ha lo stesso segno di
   <parameter>num1</parameter> e un modulo inferiore al modulo di
   <parameter>num2</parameter>.
  </para>
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>num1</parameter></term>
     <listitem>
      <para>
       Il dividendo
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>num2</parameter></term>
     <listitem>
      <para>
       Il divisore
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>
 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Il resto in virgola mobile di
   <parameter>num1</parameter>/<parameter>num2</parameter>.
   <constant>NAN</constant> (<type>float</type>) se il secondo argomento è 0.
  </para>
 </refsect1>
 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Uso di <function>fmod</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$x = 5.7;
$y = 1.3;
$r = fmod($x, $y);
// $r è uguale a 0.5, perché 4 * 1.3 + 0.5 = 5.7

var_dump($x, $y, $r);
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><link linkend="language.operators.arithmetic"><literal>/</literal></link> - Divisione in virgola mobile</member>
    <member><link linkend="language.operators.arithmetic"><literal>%</literal></link> - Modulo intero</member>
    <member><function>intdiv</function> - Divisione intera</member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
