<refentry xml:id="function.posix-setsid" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>posix_setsid</refname>
  <refpurpose>Rende il processo corrente un leader di sessione</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>posix_setsid</methodname>
   <void/>
  </methodsynopsis>
  <para>
   Rende il processo corrente un leader di sessione.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce l'ID di sessione, o -1 in caso di errore.
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member>
     Si consultino POSIX.1 e la pagina di manuale setsid(2) del sistema POSIX per maggiori
     informazioni sui gruppi di processi e sul controllo dei job.
    </member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

