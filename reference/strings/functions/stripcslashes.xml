<refentry xml:id="function.stripcslashes" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>stripcslashes</refname>
  <refpurpose>Rimuove il quoting da una stringa su cui è stato eseguito il quoting con <function>addcslashes</function></refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>stripcslashes</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>
   Restituisce una stringa priva dei backslash. Riconosce
   le rappresentazioni in stile C <literal>\n</literal>, <literal>\r</literal> ..., ottale
   ed esadecimale.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       La stringa da cui rimuovere l'escape.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la stringa senza escape.
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>stripcslashes</function></title>
    <programlisting role="php">
<![CDATA[
<?php

var_dump(stripcslashes('Vorrei un po\' di caffè.\nNessun problema.') === "Vorrei un po' di caffè.
Nessun problema."); // true
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>addcslashes</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
