<!-- runkit entities -->
<!ENTITY note.runkit.selfmanipulation '<note xmlns="http://docbook.org/ns/docbook"><simpara>Questa funzione non
può essere usata per manipolare il metodo attualmente in esecuzione (o concatenato).</simpara>
</note>'>

<!ENTITY note.runkit.internal-override '<note xmlns="http://docbook.org/ns/docbook"><simpara>Per impostazione predefinita, solo
le funzioni in userspace possono essere rimosse, rinominate o modificate. Per
effettuare l&apos;override delle funzioni interne, è necessario abilitare
l&apos;impostazione <literal>runkit.internal_override</literal> in &php.ini;.</simpara>
</note>'>

<!-- SSH2 Extension -->
<!ENTITY note.ssh2.subsystem.publickey '<note xmlns="http://docbook.org/ns/docbook"><simpara>Il sottosistema publickey
è utilizzato per gestire le chiavi pubbliche su un server sul quale il client è
<emphasis>già</emphasis> autenticato.  Per autenticarsi su un sistema remoto
utilizzando l&apos;autenticazione a chiave pubblica, utilizzare invece la funzione
<function>ssh2_auth_pubkey_file</function>.</simpara></note>'>

<!-- Session notes -->
<!ENTITY returns.session.storage.retval 'Il valore di ritorno (normalmente &true; in caso di successo, &false; in caso di fallimento). Si noti che questo valore è restituito internamente a PHP per essere elaborato.'>

