 <!-- {{{ preface -->
 <preface xml:id="intro.math">
  &reftitle.intro;
  <para>
   Queste funzioni matematiche gestiscono solo valori compresi nell'intervallo
   dei tipi <type>int</type> e <type>float</type>.
   Per gestire numeri più grandi, consultare le
   <link linkend="book.bc">funzioni matematiche a precisione arbitraria</link> o le
   <link linkend="book.gmp">funzioni GNU Multiple Precision</link>.
  </para>

  <section>
   &reftitle.seealso;
   <para>
    <simplelist>
     <member>
      <link linkend="language.operators.arithmetic">operatori aritmetici</link>
     </member>
     <member>
      <link linkend="book.bc">Funzioni matematiche a precisione arbitraria</link>
     </member>
     <member>
      <link linkend="book.gmp">Funzioni GNU Multiple Precision</link>
     </member>
    </simplelist>
   </para>
  </section>
 </preface>
