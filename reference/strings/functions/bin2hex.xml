<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.bin2hex">
 <refnamediv>
  <refname>bin2hex</refname>
  <refpurpose>Converte dati binari nella rappresentazione esadecimale</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>bin2hex</methodname>
   <methodparam><type>string</type><parameter>string</parameter></methodparam>
  </methodsynopsis>
  <para>
   Restituisce una stringa ASCII contenente la rappresentazione esadecimale
   di <parameter>string</parameter>. La conversione viene effettuata byte per byte
   a partire dal nibble più significativo.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>string</parameter></term>
     <listitem>
      <para>
       Una stringa.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce la rappresentazione esadecimale della stringa fornita.
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>bin2hex</function></title>
    <programlisting role="php">
<![CDATA[
<?php

$hex = bin2hex('Ciao mondo!');

var_dump($hex);
var_dump(hex2bin($hex));
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
string(22) "4369616f206d6f6e646f21"
string(11) "Ciao mondo!"
]]>
    </screen>
   </example>
  </para>
 </refsect1>
 
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>hex2bin</function></member>
    <member><function>pack</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
