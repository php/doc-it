<sect1 xml:id="migration56.changed-functions">
 <title>Funzioni modificate</title>

 <sect2 xml:id="migration56.changed-functions.core">
  <title>PHP Core</title>

  <itemizedlist>
   <listitem>
    <simpara>
     <function>crypt</function> ora genera un errore
     <constant>E_NOTICE</constant> se il parametro <parameter>salt</parameter>
     viene omesso.
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <function>substr_compare</function> ora accetta <literal>0</literal>
     per il suo parametro <parameter>length</parameter>.
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <function>unserialize</function> ora fallisce se le vengono passati dati serializzati
     che sono stati manipolati per tentare di istanziare un oggetto senza
     chiamarne il costruttore.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.curl">
  <title><link linkend="book.curl">cURL</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     Gli upload che utilizzano la sintassi <literal>@file</literal> sono ora supportati solo
     se l'opzione <constant>CURLOPT_SAFE_UPLOAD</constant> è impostata a
     &false;. Al suo posto si dovrebbe utilizzare <classname>CURLFile</classname>.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.mcrypt">
  <title><link linkend="book.mcrypt">Mcrypt</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     Il parametro <parameter>source</parameter> di
     <function>mcrypt_create_iv</function> ora ha come valore predefinito
     <constant>MCRYPT_DEV_URANDOM</constant> invece di
     <constant>MCRYPT_DEV_RANDOM</constant>.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.openssl">
  <title><link linkend="book.openssl">OpenSSL</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     <function>stream_socket_enable_crypto</function> ora consente che il
     parametro <parameter>crypto_type</parameter> sia opzionale se il
     contesto SSL dello stream include la nuova opzione
     <parameter>crypto_type</parameter>.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.pgsql">
  <title><link linkend="book.pgsql">PostgreSQL</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     <function>pg_insert</function>, <function>pg_select</function>,
     <function>pg_update</function> e <function>pg_delete</function> non sono
     più sperimentali.
    </simpara>
   </listitem>
   <listitem>
    <simpara>
     <function>pg_send_execute</function>,
     <function>pg_send_prepare</function>, <function>pg_send_query</function>
     e <function>pg_send_query_params</function> non bloccano più fino al
     completamento della scrittura della query se lo stream del socket sottostante per la
     connessione al database è impostato in modalità non bloccante.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.reflection">
  <title><link linkend="book.reflection">Reflection</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     <methodname>ReflectionClass::newInstanceWithoutConstructor</methodname>
     ora consente di istanziare le classi interne
     non final.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>

 <sect2 xml:id="migration56.changed-functions.xmlreader">
  <title><link linkend="book.xmlreader">XMLReader</link></title>

  <itemizedlist>
   <listitem>
    <simpara>
     <methodname>XMLReader::getAttributeNs</methodname> e
     <methodname>XMLReader::getAttributeNo</methodname> ora restituiscono &null; se
     l'attributo non viene trovato, come
     <methodname>XMLReader::getAttribute</methodname>.
    </simpara>
   </listitem>
  </itemizedlist>
 </sect2>
</sect1>

