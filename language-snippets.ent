<!ENTITY strings.errors.sprintf '
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se il numero di argomenti è zero.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se <literal>[width]</literal> è minore di zero o maggiore di <constant>PHP_INT_MAX</constant>.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se <literal>[precision]</literal> è minore di zero o maggiore di <constant>PHP_INT_MAX</constant>.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ArgumentCountError</classname> quando vengono forniti meno argomenti di quelli richiesti.
   Prima di PHP 8.0.0, veniva invece restituito &false; ed emesso un <constant>E_WARNING</constant>.
  </simpara>
'>

<!ENTITY strings.errors.vsprintf '
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se il numero di argomenti è zero.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se <literal>[width]</literal> è minore di zero o maggiore di <constant>PHP_INT_MAX</constant>.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> se <literal>[precision]</literal> è minore di zero o maggiore di <constant>PHP_INT_MAX</constant>.
   Prima di PHP 8.0.0, veniva invece emesso un <constant>E_WARNING</constant>.
  </simpara>
  <simpara xmlns="http://docbook.org/ns/docbook">
   A partire da PHP 8.0.0, viene lanciato un <classname>ValueError</classname> quando vengono forniti meno argomenti di quelli richiesti.
   Prima di PHP 8.0.0, veniva invece restituito &false; ed emesso un <constant>E_WARNING</constant>.
  </simpara>
'>

<!ENTITY strings.comparison.return '
  <simpara xmlns="http://docbook.org/ns/docbook">
   Restituisce un valore minore di 0 se <parameter>string1</parameter>
   è minore di <parameter>string2</parameter>; un valore maggiore
   di 0 se <parameter>string1</parameter> è maggiore di
   <parameter>string2</parameter>, e <literal>0</literal> se sono
   uguali.
   Non è possibile dedurre in modo affidabile alcun significato particolare dal valore, a parte
   il suo segno.
  </simpara>
'>

<!-- csprng snippets -->
<!ENTITY csprng.sources '
<simpara xmlns="http://docbook.org/ns/docbook">
 Le fonti di casualità, in ordine di priorità, sono le seguenti:
</simpara>
<itemizedlist xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <listitem>
  <simpara>
   Linux: <link xlink:href="&url.csprng.get-random-2;">getrandom()</link>, <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   FreeBSD &gt;= 12 (PHP &gt;= 7.3): <link xlink:href="&url.csprng.get-random-2;">getrandom()</link>, <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   Windows (PHP &gt;= 7.2): <link xlink:href="&url.csprng.cng-api;">CNG-API</link>
  </simpara>
  <simpara>
   Windows: <link xlink:href="&url.csprng.crypt-gen-random;">CryptGenRandom</link>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   macOS (PHP &gt;= 8.2; &gt;= 8.1.9; &gt;= 8.0.22 se CCRandomGenerateBytes è disponibile in fase di compilazione): CCRandomGenerateBytes()
  </simpara>
  <simpara>
   macOS (PHP &gt;= 8.1; &gt;= 8.0.2): arc4random_buf(), <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   NetBSD &gt;= 7 (PHP &gt;= 7.1; &gt;= 7.0.1): arc4random_buf(), <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   OpenBSD &gt;= 5.5 (PHP &gt;= 7.1; &gt;= 7.0.1): arc4random_buf(), <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   DragonflyBSD (PHP &gt;= 8.1): <link xlink:href="&url.csprng.get-random-2;">getrandom()</link>, <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   Solaris (PHP &gt;= 8.1): <link xlink:href="&url.csprng.get-random-2;">getrandom()</link>, <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   Qualsiasi combinazione di sistema operativo e versione di PHP non menzionata in precedenza: <filename>/dev/urandom</filename>
  </simpara>
 </listitem>
 <listitem>
  <simpara>
   Se nessuna delle fonti è disponibile o se tutte falliscono nel generare
   casualità, allora una <classname>Random\RandomException</classname>
   verrà lanciata.
  </simpara>
 </listitem>
</itemizedlist>
'>
<!ENTITY csprng.errors '
 <listitem xmlns="http://docbook.org/ns/docbook">
  <simpara>
   Se non è possibile trovare una fonte di casualità appropriata,
   verrà lanciata una <classname>Random\RandomException</classname>.
  </simpara>
 </listitem>
'>
<!ENTITY csprng.function.backport '
 <note xmlns="http://docbook.org/ns/docbook">
  <simpara>
   Sebbene questa funzione sia stata aggiunta in PHP 7.0, è disponibile
   un&apos;<link xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="&url.csprng.compat;">implementazione userland</link>
   per PHP dalla 5.2 alla 5.6 incluse.
  </simpara>
 </note>
'>

<!-- Random snippets -->
<!ENTITY random.engineErrors '
 <listitem xmlns="http://docbook.org/ns/docbook">
  <simpara>
   Qualsiasi <classname>Throwable</classname> lanciato dal metodo <methodname>Random\Engine::generate</methodname>
   dell&apos;<link linkend="random-randomizer.props.engine"><literal>Random\Randomizer::$engine</literal></link> sottostante.
  </simpara>
 </listitem>
'>

<!-- URI snippets -->
<!ENTITY uri.errors.invalidUriException '
  <simpara>
   Se l&apos;URI risultante non è valido, viene lanciata una <exceptionname>Uri\InvalidUriException</exceptionname>.
  </simpara>
'>

<!ENTITY uri.errors.invalidUrlException '
  <simpara>
   Se l&apos;URL risultante non è valido, viene lanciata una <exceptionname>Uri\WhatWg\InvalidUrlException</exceptionname>.
  </simpara>
'>

<!ENTITY uri.normalization '
  <simpara>
   Le triplette esadecimali vengono convertite in maiuscolo, i caratteri non riservati codificati con percent-encoding vengono decodificati, i componenti scheme e host vengono normalizzati in minuscolo e i segmenti con punti (dot segment) vengono rimossi dal percorso, secondo l&apos;RFC 3986.
  </simpara>
'>

<!ENTITY uri.non-normalization '
  <simpara>
   Le triplette esadecimali non vengono convertite in maiuscolo, i caratteri non riservati codificati con percent-encoding restano codificati, i componenti scheme e host mantengono le maiuscole e minuscole con cui sono stati forniti e i segmenti con punti (dot segment) vengono mantenuti nel percorso.
  </simpara>
'>

