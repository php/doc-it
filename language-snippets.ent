<!ENTITY xmlwriter.xmlwriter.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>writer</parameter></term><listitem><simpara>Solo per chiamate procedurali.
L&apos;istanza di <classname>XMLWriter</classname> che viene modificata. Questo oggetto deriva da una chiamata a <function>xmlwriter_open_uri</function> o <function>xmlwriter_open_memory</function>.</simpara></listitem></varlistentry>'>

<!ENTITY xmlwriter.changelog.writer-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.0.0</entry>
 <entry>
  <parameter>writer</parameter> ora si aspetta un&apos;istanza di <classname>XMLWriter</classname>;
  in precedenza, era attesa una <type>resource</type>.
 </entry>
</row>'>

<!-- SOAP notes -->
<!ENTITY soap.wsdl.mode.only "<note xmlns='http://docbook.org/ns/docbook'><simpara>Questa funzione opera solo in modalità WSDL.</simpara></note>">

<!-- Stomp notes -->
<!ENTITY stomp.param.link "<varlistentry xmlns='http://docbook.org/ns/docbook'><term><parameter>link</parameter></term><listitem><simpara>Solo nello stile procedurale: l&apos;identificatore di connessione stomp restituito da <function>stomp_connect</function>.</simpara></listitem></varlistentry>">
<!ENTITY stomp.param.headers "<varlistentry xmlns='http://docbook.org/ns/docbook'><term><parameter>headers</parameter></term><listitem><simpara>Array associativo che contiene le intestazioni aggiuntive (per esempio: receipt).</simpara></listitem></varlistentry>">
<!ENTITY stomp.note.transaction "<note xmlns='http://docbook.org/ns/docbook'><simpara>Può essere specificata un&apos;intestazione di transazione, che indica che la conferma del messaggio deve far parte della transazione specificata.</simpara></note>">
<!ENTITY stomp.note.sync "<tip xmlns='http://docbook.org/ns/docbook'><simpara>Stomp è intrinsecamente asincrono. La comunicazione sincrona può essere implementata aggiungendo un&apos;intestazione receipt. Questo fa sì che i metodi non restituiscano nulla finché il server non ha confermato la ricezione del messaggio o finché non viene raggiunto il timeout di lettura.</simpara></tip>">

<!-- SVN notes -->
<!ENTITY svn.relativepath "<note xmlns='http://docbook.org/ns/docbook'><simpara>I percorsi relativi verranno risolti come se la directory di lavoro corrente fosse quella che contiene il binario PHP. Per usare la directory di lavoro dello script chiamante, usare <function>realpath</function> o dirname(__FILE__).</simpara></note>">
<!ENTITY svn.referto.status 'Consultare le <link xmlns="http://docbook.org/ns/docbook" linkend="svn.constants.status">costanti di stato</link> per i possibili valori.'>
<!ENTITY svn.referto.type 'Consultare le <link xmlns="http://docbook.org/ns/docbook" linkend="svn.constants.type">costanti di tipo</link> per i possibili valori.'>

