<refentry xml:id="function.checkdnsrr" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <refnamediv>
  <refname>checkdnsrr</refname>
  <refpurpose>Controlla i record DNS corrispondenti a un dato nome host Internet o indirizzo IP</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>checkdnsrr</methodname>
   <methodparam><type>string</type><parameter>hostname</parameter></methodparam>
   <methodparam choice="opt"><type>string</type><parameter>type</parameter><initializer>"MX"</initializer></methodparam>
  </methodsynopsis>
  <para>
   Cerca nel DNS i record di tipo <parameter>type</parameter>
   corrispondenti a <parameter>hostname</parameter>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>hostname</parameter></term>
     <listitem>
      <para>
       <parameter>hostname</parameter> può essere l'indirizzo IP in
       notazione decimale puntata oppure il nome host.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>type</parameter></term>
     <listitem>
      <para>
       <parameter>type</parameter> può essere uno tra: A, MX, NS, SOA,
       PTR, CNAME, AAAA, A6, SRV, NAPTR, TXT o ANY.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce &true; se vengono trovati dei record; restituisce &false; se non viene trovato
   alcun record o se si è verificato un errore.
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <para>
    Per la compatibilità con Windows prima che questa funzione fosse implementata, provare la
    classe <link xlink:href="&url.php.pear;">PEAR</link>
    <link xlink:href="&url.pear.package;Net_DNS">Net_DNS</link>.
   </para>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>dns_get_record</function></member>
    <member><function>getmxrr</function></member>
    <member><function>gethostbyaddr</function></member>
    <member><function>gethostbyname</function></member>
    <member><function>gethostbynamel</function></member>
    <member>la pagina di manuale named(8)</member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
