<refentry xml:id="function.posix-kill" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>posix_kill</refname>
  <refpurpose>Invia un segnale a un processo</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>posix_kill</methodname>
   <methodparam><type>int</type><parameter>process_id</parameter></methodparam>
   <methodparam><type>int</type><parameter>signal</parameter></methodparam>
  </methodsynopsis>
  <para>
   Invia il segnale <parameter>signal</parameter> al processo con
   l'identificativo di processo <parameter>process_id</parameter>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>process_id</parameter></term>
     <listitem>
      <para>
       L'identificativo del processo.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>signal</parameter></term>
     <listitem>
      <para>
       Una delle <link linkend="pcntl.constants">costanti dei segnali PCNTL</link>.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.success;
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.5.0</entry>
      <entry>
       Ora lancia un <exceptionname>ValueError</exceptionname> quando
       <parameter>process_id</parameter> è minore o maggiore di quanto
       supportato dalla piattaforma (intervallo di signed integer o long).
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member>
     La pagina di manuale kill(2) del sistema POSIX, che contiene ulteriori
     informazioni sugli identificatori di processo negativi, sul pid speciale 0, sul
     pid speciale -1 e sul numero di segnale 0.
    </member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
