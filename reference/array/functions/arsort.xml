<refentry xml:id="function.arsort" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>arsort</refname>
  <refpurpose>Ordina un array in ordine decrescente mantenendo l'associazione degli indici</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>true</type><methodname>arsort</methodname>
   <methodparam><type>array</type><parameter role="reference">array</parameter></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>flags</parameter><initializer><constant>SORT_REGULAR</constant></initializer></methodparam>
  </methodsynopsis>
  <para>
   Ordina <parameter>array</parameter> sul posto in ordine decrescente,
   in modo che le sue chiavi mantengano la corrispondenza con i valori a cui
   sono associate.
  </para>
  <para>
   Viene usata principalmente per ordinare array associativi in cui conta
   l'effettivo ordine degli elementi.
  </para>
  &note.sort-unstable;
  &note.reset-index;
 </refsect1>
 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>array</parameter></term>
     <listitem>
      <para>
       L'array in input.
      </para>
     </listitem>
    </varlistentry>
    &sort.flags.parameter;
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   &return.true.always;
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <para>
   <informaltable>
    <tgroup cols="2">
     <thead>
      <row>
       <entry>&Version;</entry>
       <entry>&Description;</entry>
      </row>
     </thead>
     <tbody>
      &return.type.true;
     </tbody>
    </tgroup>
   </informaltable>
  </para>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>arsort</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$fruits = array("d" => "limone", "a" => "arancia", "b" => "banana", "c" => "mela");
arsort($fruits);
foreach ($fruits as $key => $val) {
    echo "$key = $val\n";
}
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
c = mela
d = limone
b = banana
a = arancia
]]>
    </screen>
    <para>
     La frutta è stata ordinata in ordine alfabetico inverso, e
     l'indice associato a ogni elemento è stato mantenuto.
    </para>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <simplelist>
   <member><function>sort</function></member>
   <member><function>asort</function></member>
   <member>&seealso.array.sorting;</member>
  </simplelist>
 </refsect1>

</refentry>
