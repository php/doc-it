<refentry xml:id="function.session-encode" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>session_encode</refname>
  <refpurpose>Codifica i dati di sessione correnti come stringa codificata di sessione</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>string</type><type>false</type></type><methodname>session_encode</methodname>
   <void/>
  </methodsynopsis>
  <para>
   <function>session_encode</function> restituisce una stringa serializzata del
   contenuto dei dati di sessione correnti memorizzati nella superglobale $_SESSION.
  </para>
  <para>
   Per impostazione predefinita, il metodo di serializzazione usato è interno a PHP e non è lo stesso di <function>serialize</function>.
   Il metodo di serializzazione può essere impostato tramite <link linkend="ini.session.serialize-handler">session.serialize_handler</link>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  &no.function.parameters;
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce il contenuto della sessione corrente codificato&return.falseforfailure;.
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <warning>
   <para>
    Occorre chiamare <function>session_start</function> prima di usare <function>session_encode</function>.
   </para>
  </warning>
 </refsect1> 
 
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>session_decode</function></member>
    <member><link linkend="ini.session.serialize-handler">session.serialize_handler</link></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
