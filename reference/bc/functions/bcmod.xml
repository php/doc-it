<refentry xml:id="function.bcmod" xmlns="http://docbook.org/ns/docbook" xmlns:xi="http://www.w3.org/2001/XInclude">
 <refnamediv>
  <refname>bcmod</refname>
  <refpurpose>Ottiene il modulo di un numero a precisione arbitraria</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>string</type><methodname>bcmod</methodname>
   <methodparam><type>string</type><parameter>num1</parameter></methodparam>
   <methodparam><type>string</type><parameter>num2</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>int</type><type>null</type></type><parameter>scale</parameter><initializer>&null;</initializer></methodparam>
  </methodsynopsis>
  <para>
   Ottiene il resto della divisione di <parameter>num1</parameter> per
   <parameter>num2</parameter>.
   Il risultato ha lo stesso segno di <parameter>num1</parameter>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('function.bcadd')/db:refsect1[@role='parameters']/*)" />
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce il modulo come stringa.
  </para>
 </refsect1>

 <xi:include xpointer="xmlns(db=http://docbook.org/ns/docbook) xpointer(id('function.bcdiv')/db:refsect1[@role='errors'])" />

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       <parameter>scale</parameter> ora è nullable.
      </entry>
     </row>
     <row>
      <entry>8.0.0</entry>
      <entry>
       La divisione per <literal>0</literal> ora lancia un'eccezione <exceptionname>DivisionByZeroError</exceptionname> invece di restituire null.
      </entry>
     </row>
     <row>
      <entry>7.2.0</entry>
      <entry>
       <parameter>num1</parameter> e <parameter>num2</parameter> non vengono più
       troncati a intero, quindi ora il comportamento di
       <function>bcmod</function> segue <function>fmod</function> anziché
       l'operatore <literal>%</literal>.
      </entry>
     </row>
     <row>
      <entry>7.2.0</entry>
      <entry>
       È stato aggiunto il parametro <parameter>scale</parameter>.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <example>
   <title>Esempio di <function>bcmod</function></title>
   <programlisting role="php">
<![CDATA[
<?php
bcscale(0);
echo bcmod( '5',  '3'); //  2
echo bcmod( '5', '-3'); //  2
echo bcmod('-5',  '3'); // -2
echo bcmod('-5', '-3'); // -2
?>
]]>
   </programlisting>
  </example>
  <example>
   <title><function>bcmod</function> con decimali</title>
   <programlisting role="php">
<![CDATA[
<?php
bcscale(1);
echo bcmod('5.7', '1.3'); // 0.5 a partire da PHP 7.2.0; 0 in precedenza
?>
]]>
   </programlisting>
  </example>
 </refsect1>
 
 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>bcdiv</function></member>
    <member><function>bcdivmod</function></member>
   <member><methodname>BcMath\Number::mod</methodname></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>
