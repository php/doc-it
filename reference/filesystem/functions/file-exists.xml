<refentry xmlns="http://docbook.org/ns/docbook" xml:id="function.file-exists">
 <refnamediv>
  <refname>file_exists</refname>
  <refpurpose>Controlla se un file o una directory esiste</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>bool</type><methodname>file_exists</methodname>
   <methodparam><type>string</type><parameter>filename</parameter></methodparam>
  </methodsynopsis>
  <para>
   Controlla se un file o una directory esiste.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>filename</parameter></term>
     <listitem>
      <para>
       Percorso del file o della directory.
      </para>
      <para>
       Su Windows, usare <filename>//computername/share/filename</filename> oppure
       <filename>\\computername\share\filename</filename> per controllare i file su
       condivisioni di rete.
      </para>
     </listitem>
    </varlistentry>
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce &true; se il file o la directory specificata da
   <parameter>filename</parameter> esiste; &false; altrimenti.
  </para>
  <note>
   <para>
    Questa funzione restituisce &false; per i collegamenti simbolici che puntano a file
    inesistenti.
   </para>
  </note>
  <note>
   <para>
    Il controllo viene effettuato usando l'UID/GID reale invece di quello effettivo.
   </para>
  </note>
  &fs.file.32bit;
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  &fs.emits.warning.on.failure;
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Verificare l'esistenza di un file</title>
    <programlisting role="php">
<![CDATA[
<?php
$filename = '/path/to/foo.txt';

if (file_exists($filename)) {
    echo "Il file $filename esiste";
} else {
    echo "Il file $filename non esiste";
}
?>
]]>
    </programlisting>
   </example>
  </para>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  &ext.filesystem.access-check-cache;
  &tip.fopen-wrapper.stat;
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>is_readable</function></member>
    <member><function>is_writable</function></member>
    <member><function>is_file</function></member>
    <member><function>file</function></member>
    <member><classname>SplFileInfo</classname></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>

