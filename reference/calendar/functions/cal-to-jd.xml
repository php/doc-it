<refentry xml:id='function.cal-to-jd' xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>cal_to_jd</refname>
  <refpurpose>Converte da un calendario supportato al Giorno Giuliano</refpurpose>
 </refnamediv>

 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type>int</type><methodname>cal_to_jd</methodname>
   <methodparam><type>int</type><parameter>calendar</parameter></methodparam>
   <methodparam><type>int</type><parameter>month</parameter></methodparam>
   <methodparam><type>int</type><parameter>day</parameter></methodparam>
   <methodparam><type>int</type><parameter>year</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>cal_to_jd</function> calcola il numero del giorno giuliano
   per una data nel calendario <parameter>calendar</parameter> specificato.
   I valori di <parameter>calendar</parameter> supportati sono
   <constant>CAL_GREGORIAN</constant>,
   <constant>CAL_JULIAN</constant>,
   <constant>CAL_JEWISH</constant> e
   <constant>CAL_FRENCH</constant>.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   <variablelist>
    <varlistentry>
     <term><parameter>calendar</parameter></term>
     <listitem>
      <para>
       Calendario da cui convertire, uno tra
       <constant>CAL_GREGORIAN</constant>,
       <constant>CAL_JULIAN</constant>,
       <constant>CAL_JEWISH</constant> o
       <constant>CAL_FRENCH</constant>.
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>month</parameter></term>
     <listitem>
      <para>
       Il mese come numero; l'intervallo valido dipende
       dal <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>day</parameter></term>
     <listitem>
      <para>
       Il giorno come numero; l'intervallo valido dipende
       dal <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>
    <varlistentry>
     <term><parameter>year</parameter></term>
     <listitem>
      <para>
       L'anno come numero; l'intervallo valido dipende
       dal <parameter>calendar</parameter>
      </para>
     </listitem>
    </varlistentry>  
   </variablelist>
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Un numero del Giorno Giuliano.
  </para>
 </refsect1>

 <refsect1 role="errors">
  &reftitle.errors;
  <simpara>
   Lancia un <exceptionname>ValueError</exceptionname> se <parameter>calendar</parameter>
   non è un ID di calendario valido, se <parameter>month</parameter> è minore di <literal>1</literal>,
   o se <parameter>month</parameter>, <parameter>day</parameter> o <parameter>year</parameter>
   supera l'intervallo a 32 bit supportato. Le altre date non valide restituiscono <literal>0</literal>.
  </simpara>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     <row>
      <entry>8.0.0</entry>
      <entry>
       Ora lancia un <exceptionname>ValueError</exceptionname> se <parameter>calendar</parameter>
       non è un ID di calendario valido.
       In precedenza veniva generato un <constant>E_WARNING</constant> e veniva restituito &false;.
      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>cal_from_jd</function></member>
    <member><function>frenchtojd</function></member> 
    <member><function>gregoriantojd</function></member>  
    <member><function>jewishtojd</function></member>  
    <member><function>juliantojd</function></member>  
    <member><function>unixtojd</function></member>
   </simplelist>
  </para>
 </refsect1>
</refentry>

