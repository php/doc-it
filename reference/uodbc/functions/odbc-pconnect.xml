<refentry xml:id="function.odbc-pconnect" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>odbc_pconnect</refname>
  <refpurpose>Apre una connessione persistente a un database</refpurpose>
 </refnamediv>
 
 <refsect1 role="description">
  &reftitle.description;
  <methodsynopsis>
   <type class="union"><type>Odbc\Connection</type><type>false</type></type><methodname>odbc_pconnect</methodname>
   <methodparam><type>string</type><parameter>dsn</parameter></methodparam>
   <methodparam choice="opt"><type class="union"><type>string</type><type>null</type></type><parameter>user</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><modifier role="attribute">#[\SensitiveParameter]</modifier><type class="union"><type>string</type><type>null</type></type><parameter>password</parameter><initializer>&null;</initializer></methodparam>
   <methodparam choice="opt"><type>int</type><parameter>cursor_option</parameter><initializer><constant>SQL_CUR_USE_DRIVER</constant></initializer></methodparam>
  </methodsynopsis>
  <para>
   Apre una connessione persistente a un database.
  </para>
  <para>
   Questa funzione è molto simile a
   <function>odbc_connect</function>, tranne per il fatto che la connessione
   non viene realmente chiusa al termine dello script. Le successive richieste
   di una connessione con la stessa combinazione di <parameter>dsn</parameter>,
   <parameter>user</parameter> e <parameter>password</parameter>
   (tramite <function>odbc_connect</function> e
   <function>odbc_pconnect</function>) possono riutilizzare la connessione
   persistente.
  </para>
 </refsect1>

 <refsect1 role="parameters">
  &reftitle.parameters;
  <para>
   Si veda <function>odbc_connect</function> per i dettagli.
  </para>
 </refsect1>

 <refsect1 role="returnvalues">
  &reftitle.returnvalues;
  <para>
   Restituisce una connessione ODBC&return.falseforfailure;.
  </para>
 </refsect1>

 <refsect1 role="changelog">
  &reftitle.changelog;
  <informaltable>
   <tgroup cols="2">
    <thead>
     <row>
      <entry>&Version;</entry>
      <entry>&Description;</entry>
     </row>
    </thead>
    <tbody>
     &odbc.changelog.connection-return;
     &odbc.changelog.credential-params;
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="notes">
  &reftitle.notes;
  <note>
   <simpara>
    Le connessioni persistenti non hanno effetto se PHP viene utilizzato come
    programma CGI.
   </simpara>
  </note>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>odbc_connect</function></member>
    <member><link linkend="features.persistent-connections">Connessioni Persistenti ai Database</link></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
