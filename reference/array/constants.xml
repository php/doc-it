<appendix xml:id="array.constants" xmlns="http://docbook.org/ns/docbook">
 &reftitle.constants;
 &extension.constants.core;
 <para>
 <variablelist>
  <varlistentry xml:id="constant.case-lower">
   <term>
    <constant>CASE_LOWER</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>CASE_LOWER</constant> è usata con
     <function>array_change_key_case</function> per convertire le chiavi di
     un array a caratteri minuscoli. E' anche il valore di default per
     <function>array_change_key_case</function>. A partire da PHP 8.2.0, solo i
     caratteri ASCII vengono convertiti.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.case-upper">
   <term>
    <constant>CASE_UPPER</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>CASE_UPPER</constant> è usata con
     <function>array_change_key_case</function> per convertire le chiavi di
     un array a caratteri maiuscoli. A partire da PHP 8.2.0, solo i caratteri
     ASCII vengono convertiti.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>
 </para>

 <para>Flag per l'ordinamento:
 <variablelist>
  <varlistentry xml:id="constant.sort-asc">
   <term>
    <constant>SORT_ASC</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>SORT_ASC</constant> è usata con
     <function>array_multisort</function> per ordinare in modo crescente.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-desc">
   <term>
    <constant>SORT_DESC</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>SORT_DESC</constant> è usata con
     <function>array_multisort</function>per ordinare in modo decrescente.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>
 </para>

 <para> Flag per il tipo dell'ordinamento:
 <variablelist>
  <varlistentry xml:id="constant.sort-regular">
   <term>
    <constant>SORT_REGULAR</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>SORT_REGULAR</constant> è usata per effettuare un normale confronto.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-numeric">
   <term>
    <constant>SORT_NUMERIC</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>SORT_NUMERIC</constant> è usata per effettuare in modo numerico.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-string">
   <term>
    <constant>SORT_STRING</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
    <constant>SORT_STRING</constant> è usata per effettuare un confronto tra stringhe.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-locale-string">
   <term>
    <constant>SORT_LOCALE_STRING</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
    <constant>SORT_LOCALE_STRING</constant> è usata per effettuare un confronto
     tra stringhe basate sul locale corrente.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-natural">
   <term>
    <constant>SORT_NATURAL</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
    <constant>SORT_NATURAL</constant> è usata per effettuare un confronto tra stringhe
     usando un "confronto naturale" come <function>natsort</function>.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.sort-flag-case">
   <term>
    <constant>SORT_FLAG_CASE</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>SORT_FLAG_CASE</constant> può essere combinata (OR bit a bit) con
     <constant>SORT_STRING</constant> o <constant>SORT_NATURAL</constant> per
     ordinare le stringhe senza distinzione tra maiuscole e minuscole. A partire
     da PHP 8.2.0, viene applicato solo il case folding ASCII.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>
 </para>

 <para> Flag per il filtro:
 <variablelist>
  <varlistentry xml:id="constant.array-filter-use-key">
   <term>
    <constant>ARRAY_FILTER_USE_KEY</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>ARRAY_FILTER_USE_KEY</constant> è usata con
     <function>array_filter</function> per passare ogni chiave come primo argomento alla funzione di callback indicata.
    </simpara>
   </listitem>
  </varlistentry>
  <varlistentry xml:id="constant.array-filter-use-both">
   <term>
    <constant>ARRAY_FILTER_USE_BOTH</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     <constant>ARRAY_FILTER_USE_BOTH</constant> è usata con
     <function>array_filter</function> per passare sia il valore sia la chiave alla funzione di callback indicata.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>
 </para>

