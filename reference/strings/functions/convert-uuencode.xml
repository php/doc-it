      </entry>
     </row>
    </tbody>
   </tgroup>
  </informaltable>
 </refsect1>

 <refsect1 role="examples">
  &reftitle.examples;
  <para>
   <example>
    <title>Esempio di <function>convert_uuencode</function></title>
    <programlisting role="php">
<![CDATA[
<?php
$some_string = "prova\ntesto testo\r\n";

echo convert_uuencode($some_string);
?>
]]>
    </programlisting>
    &example.outputs;
    <screen>
<![CDATA[
3<')O=F$*=&5S=&\@=&5S=&\-"@``
`
]]>
    </screen>
   </example>
  </para>
 </refsect1>

 <refsect1 role="seealso">
  &reftitle.seealso;
  <para>
   <simplelist>
    <member><function>convert_uudecode</function></member>
    <member><function>base64_encode</function></member>
   </simplelist>
  </para>
 </refsect1>

</refentry>
