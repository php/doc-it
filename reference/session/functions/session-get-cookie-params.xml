     </thead>
     <tbody>
      <row>
       <entry>8.5.0</entry>
       <entry>
        È stato aggiunto l'elemento "partitioned" nell'array restituito.
       </entry>
      </row>
      <row>
       <entry>7.3.0</entry>
       <entry>
        È stato aggiunto l'elemento "samesite" nell'array restituito.
       </entry>
      </row>
     </tbody>
    </tgroup>
   </informaltable>
  </para>
 </refsect1>

