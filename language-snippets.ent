<!-- PGSQL entities -->

<!ENTITY pgsql.parameter.connection '<simpara xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>PgSql\Connection</classname>.</simpara>'>

<!ENTITY pgsql.parameter.connection-with-unspecified-default '<para xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>PgSql\Connection</classname>.
Quando <parameter>connection</parameter> non è specificato, viene usata la connessione predefinita.
La connessione predefinita è l&apos;ultima connessione effettuata da <function>pg_connect</function>
o <function>pg_pconnect</function>.
<warning><simpara>A partire da PHP 8.1.0, l&apos;uso della connessione predefinita è deprecato.</simpara></warning></para>'>

<!ENTITY pgsql.parameter.connection-with-nullable-default '<para xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>PgSql\Connection</classname>.
Quando <parameter>connection</parameter> è &null;, viene usata la connessione predefinita.
La connessione predefinita è l&apos;ultima connessione effettuata da <function>pg_connect</function>
o <function>pg_pconnect</function>.
<warning><simpara>A partire da PHP 8.1.0, l&apos;uso della connessione predefinita è deprecato.</simpara></warning></para>'>

<!ENTITY pgsql.parameter.result '<simpara xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>PgSql\Result</classname>, restituita da <function>pg_query</function>,
<function>pg_query_params</function> o <function>pg_execute</function> (tra le altre).</simpara>'>

<!ENTITY pgsql.parameter.lob '<simpara xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>PgSql\Lob</classname>, restituita da <function>pg_lo_open</function>.</simpara>'>

<!ENTITY pgsql.parameter.mode '<simpara xmlns="http://docbook.org/ns/docbook">
Un parametro opzionale che controlla come viene indicizzato l&apos;<type>array</type> restituito.
<parameter>mode</parameter> è una costante e può assumere i seguenti valori:
<constant>PGSQL_ASSOC</constant>, <constant>PGSQL_NUM</constant> e <constant>PGSQL_BOTH</constant>.
Usando <constant>PGSQL_NUM</constant>, la funzione restituirà un array con indici numerici,
usando <constant>PGSQL_ASSOC</constant> restituirà solo indici associativi
mentre con <constant>PGSQL_BOTH</constant> restituirà sia indici numerici che associativi.</simpara>'>

<!ENTITY pgsql.changelog.connection-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>connection</parameter> ora si aspetta un&apos;istanza di <classname>PgSql\Connection</classname>;
  in precedenza, era attesa una &resource;.
 </entry>
</row>'>

<!ENTITY pgsql.changelog.result-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>result</parameter> ora si aspetta un&apos;istanza di <classname>PgSql\Result</classname>;
  in precedenza, era attesa una &resource;.
 </entry>
</row>'>

<!ENTITY pgsql.changelog.lob-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>lob</parameter> ora si aspetta un&apos;istanza di <classname>PgSql\Lob</classname>;
  in precedenza, era attesa una &resource;.
 </entry>
</row>'>

<!ENTITY pgsql.changelog.return-result-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Ora restituisce un&apos;istanza di <classname>PgSql\Result</classname>;
  in precedenza, veniva restituita una &resource;.
 </entry>
</row>'>

<!-- SNMP entities -->

<!ENTITY snmp.changelog.auth-protocol-sha2 '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il protocollo di autenticazione ora accetta <literal>"SHA256"</literal>
  e <literal>"SHA512"</literal> quando supportati dalla libreria Net-SNMP.
 </entry>
</row>'>

<!ENTITY snmp.changelog.privacy-protocol-aes '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.6.0</entry>
 <entry>
  Il protocollo di privacy ora accetta <literal>"AES192"</literal>,
  <literal>"AES192C"</literal>, <literal>"AES256"</literal> e
  <literal>"AES256C"</literal> quando supportati dalla libreria Net-SNMP.
 </entry>
</row>'>

<!ENTITY snmp.parameter.security-name '<simpara xmlns="http://docbook.org/ns/docbook">Il nome di sicurezza, solitamente una sorta di nome utente.</simpara>'>

<!ENTITY snmp.parameter.security-level '<simpara xmlns="http://docbook.org/ns/docbook">Il livello di sicurezza: <literal>"noAuthNoPriv"</literal>,
<literal>"authNoPriv"</literal> o <literal>"authPriv"</literal>.</simpara>'>

<!ENTITY snmp.parameter.auth-protocol '<simpara xmlns="http://docbook.org/ns/docbook">Il protocollo di autenticazione: <literal>"MD5"</literal>, <literal>"SHA"</literal>,
<literal>"SHA256"</literal> o <literal>"SHA512"</literal>.</simpara>'>

<!ENTITY snmp.parameter.auth-passphrase '<simpara xmlns="http://docbook.org/ns/docbook">La passphrase di autenticazione.</simpara>'>

<!ENTITY snmp.parameter.privacy-protocol '<simpara xmlns="http://docbook.org/ns/docbook">Il protocollo di privacy: <literal>"DES"</literal> o <literal>"AES"</literal>,
accettato anche come <literal>"AES128"</literal>. <literal>"AES192"</literal>, <literal>"AES192C"</literal>,
<literal>"AES256"</literal> e <literal>"AES256C"</literal> sono accettati quando supportati dalla
libreria Net-SNMP.</simpara>'>

<!ENTITY snmp.parameter.privacy-passphrase '<simpara xmlns="http://docbook.org/ns/docbook">La passphrase di privacy.</simpara>'>

<!-- Common pieces for reference part END -->

<!ENTITY windows.builtin '<simpara xmlns="http://docbook.org/ns/docbook">La versione per Windows di PHP ha il supporto
integrato per questa estensione. Non è necessario caricare alcuna estensione
aggiuntiva per poter utilizzare queste funzioni.</simpara>'>

<!-- These are here as helpers for manual consistency and brevity-->

<!ENTITY sqlsafemode '<link xmlns="http://docbook.org/ns/docbook" linkend="ini.sql.safe-mode">modalità sicura SQL</link>'>

<!-- CTYPE Notes -->
<!ENTITY note.ctype.parameter.integer '<note xmlns="http://docbook.org/ns/docbook"><simpara>
Se viene fornito un <type>int</type> compreso tra -128 e 255 inclusi, viene interpretato come
il valore ASCII di un singolo carattere (ai valori negativi viene aggiunto 256 in modo da permettere
i caratteri dell&apos;intervallo Extended ASCII). Qualsiasi altro intero è interpretato come una stringa
contenente le cifre decimali dell&apos;intero.</simpara></note>'>

<!ENTITY note.ctype.parameter.non-string '<warning xmlns="http://docbook.org/ns/docbook"><simpara>
A partire da PHP 8.1.0, il passaggio di un argomento non stringa è deprecato.
In futuro, l&apos;argomento sarà interpretato come una stringa invece che come un codepoint ASCII.
A seconda del comportamento desiderato, l&apos;argomento dovrebbe essere convertito in &string;
oppure si dovrebbe effettuare una chiamata esplicita a <function>chr</function>.</simpara></warning>'>

<!ENTITY ctype.result.empty-string 'Quando viene chiamata con una stringa vuota il risultato sarà sempre &false;.'>

<!-- FTP Notes -->
<!ENTITY ftp.changelog.ftp-param '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.1.0</entry>
 <entry>
  Il parametro <parameter>ftp</parameter> ora si aspetta un&apos;istanza di <classname>FTP\Connection</classname>;
  in precedenza, era attesa una &resource;.
 </entry>
</row>'>
<!ENTITY ftp.parameter.ftp '<simpara xmlns="http://docbook.org/ns/docbook">Un&apos;istanza di <classname>FTP\Connection</classname>.</simpara>'>

<!-- GMP Notes -->
<!ENTITY gmp.return 'Un oggetto <classname xmlns="http://docbook.org/ns/docbook">GMP</classname>.'>
<!ENTITY gmp.parameter '<simpara xmlns="http://docbook.org/ns/docbook">
 Un oggetto <classname>GMP</classname>, un &integer;
 o una &string; che può essere interpretata come un numero seguendo la stessa logica
 usata se la stringa fosse passata a <function>gmp_init</function> con il rilevamento automatico
 della base (cioè quando <parameter>base</parameter> è uguale a 0).
</simpara>'>

<!-- MySQLi Notes -->
<!ENTITY mysqli.result.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>result</parameter></term><listitem><simpara>Solo nello stile procedurale: un oggetto <classname>mysqli_result</classname>
restituito da <function>mysqli_query</function>, <function>mysqli_store_result</function>,
<function>mysqli_use_result</function> o <function>mysqli_stmt_get_result</function>.</simpara></listitem></varlistentry>'>
<!ENTITY mysqli.link.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>mysql</parameter></term><listitem><simpara>Solo nello stile procedurale: un oggetto <classname>mysqli</classname>
restituito da <function>mysqli_connect</function> o <function>mysqli_init</function>
</simpara></listitem></varlistentry>'>
<!ENTITY mysqli.stmt.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>statement</parameter></term><listitem><simpara>Solo nello stile procedurale: un oggetto <classname>mysqli_stmt</classname>
restituito da <function>mysqli_stmt_init</function>.</simpara></listitem></varlistentry>'>
<!ENTITY mysqli.available.mysqlnd 'Disponibile solo con <link xmlns="http://docbook.org/ns/docbook"
linkend="book.mysqlnd">mysqlnd</link>.'>
<!ENTITY mysqli.charset.note '<note xmlns="http://docbook.org/ns/docbook">
<simpara>MySQLnd assume sempre il set di caratteri predefinito del server. Questo set di caratteri viene inviato durante
l&apos;handshake/autenticazione della connessione, e mysqlnd lo utilizzerà.</simpara><simpara>Libmysqlclient usa il set di caratteri predefinito impostato nel file
<filename>my.cnf</filename> o tramite una chiamata esplicita a <function>mysqli_options</function> prima di
chiamare <function>mysqli_real_connect</function>, ma dopo <function>mysqli_init</function>.</simpara></note>'>
<!ENTITY mysqli.integer.overflow.as.string.note '<note xmlns="http://docbook.org/ns/docbook">
<simpara>Se il numero di righe è maggiore di <constant>PHP_INT_MAX</constant>,
il numero verrà restituito come &string;.</simpara></note>'>
<!ENTITY mysqli.sqlinjection.warning '<warning xmlns="http://docbook.org/ns/docbook">
<title>Avviso di sicurezza: SQL injection</title><simpara>Se la query contiene input
variabile, si dovrebbero usare invece i <link linkend="mysqli.quickstart.prepared-statements">prepared statement
parametrizzati</link>. In alternativa, i
dati devono essere formattati correttamente e si deve usare
la funzione <function>mysqli_real_escape_string</function> per effettuare
l&apos;escape di tutte le stringhe.</simpara></warning>'>
<!ENTITY mysqli.conditionalexception '<simpara xmlns="http://docbook.org/ns/docbook">
Se la segnalazione degli errori di mysqli è abilitata (<constant>MYSQLI_REPORT_ERROR</constant>) e l&apos;operazione richiesta fallisce,
viene generato un avviso. Se, inoltre, la modalità è impostata a <constant>MYSQLI_REPORT_STRICT</constant>,
viene invece lanciata una <classname>mysqli_sql_exception</classname>.</simpara>'>

<!-- Notes for PCRE -->
<!ENTITY pcre.pattern.warning '<simpara xmlns="http://docbook.org/ns/docbook">
Se il pattern regex passato non viene compilato in una regex valida, viene emesso un <constant>E_WARNING</constant>.
</simpara>'>

<!-- Notes for SAPI/Apache -->
<!ENTITY apache.req.module '<simpara xmlns="http://docbook.org/ns/docbook">Questa funzione è supportata quando PHP
è installato come modulo del webserver Apache.
</simpara>'>

<!-- Notes for SAPI/FPM -->
<!ENTITY fpm.intro '<simpara xmlns="http://docbook.org/ns/docbook">FPM (FastCGI Process Manager) è
un&apos;implementazione primaria di PHP FastCGI contenente alcune funzionalità (per lo più) utili per i siti con carichi elevati.
</simpara>'>

<!-- SimpleXML Notes -->
<!ENTITY simplexml.iteration '<note xmlns="http://docbook.org/ns/docbook"><simpara>SimpleXML ha adottato la regola di aggiungere
proprietà iterative alla maggior parte dei metodi. Queste non possono essere visualizzate con <function>var_dump</function>
o qualsiasi altra cosa che possa esaminare gli oggetti.</simpara></note>'>

<!-- Database Notes -->
<!ENTITY database.field-case '<note xmlns="http://docbook.org/ns/docbook"><simpara>I nomi dei campi restituiti da questa funzione
sono <emphasis>case-sensitive</emphasis>.</simpara></note>'>

<!ENTITY database.fetch-null '<note xmlns="http://docbook.org/ns/docbook"><simpara>Questa funzione imposta i campi NULL al
valore PHP &null;.</simpara></note>'>

<!-- The mysql.*.description entities are used in the parameters refsect1 -->
<!ENTITY mysql.linkid.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>link_identifier</parameter></term><listitem><simpara>La connessione MySQL. Se
l&apos;identificativo di connessione non è specificato, viene usata l&apos;ultima connessione aperta da
<function>mysql_connect</function>. Se tale connessione non viene trovata, si
cercherà di crearne una come se <function>mysql_connect</function> fosse stata chiamata
senza argomenti. Se nessuna connessione viene trovata o stabilita, viene generato un
errore di livello <constant>E_WARNING</constant>.</simpara></listitem>
</varlistentry>'>

<!ENTITY mysql.linkid-noreopen.description '<varlistentry
xmlns="http://docbook.org/ns/docbook"><term>
<parameter>link_identifier</parameter></term><listitem><simpara>La connessione MySQL. Se
l&apos;identificativo di connessione non è specificato, viene usata l&apos;ultima connessione aperta da
<function>mysql_connect</function>. Se nessuna connessione viene trovata o
stabilita, viene generato un errore di livello
<constant>E_WARNING</constant>.</simpara></listitem></varlistentry>'>

<!ENTITY mysql.result.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>result</parameter></term><listitem><simpara>La <type>resource</type> del risultato che
viene valutata. Questo risultato deriva da una chiamata a
<function>mysql_query</function>.</simpara></listitem></varlistentry>'>

<!ENTITY mysql.field-offset.req.description '<varlistentry xmlns="http://docbook.org/ns/docbook"><term>
<parameter>field_offset</parameter></term><listitem><simpara>L&apos;offset numerico del campo.
<parameter>field_offset</parameter> inizia da <literal>0</literal>. Se
<parameter>field_offset</parameter> non esiste, viene generato anche un errore di livello
<constant>E_WARNING</constant>.</simpara></listitem></varlistentry>'>

<!ENTITY mysql.alternative.note '<simpara xmlns="http://docbook.org/ns/docbook">Questa estensione è stata deprecata in PHP 5.5.0 ed è stata rimossa in PHP 7.0.0.
Al suo posto, si dovrebbe usare l&apos;estensione <link linkend="book.mysqli">MySQLi</link> o <link linkend="ref.pdo-mysql">PDO_MySQL</link>.
Vedere anche la guida <link linkend="mysqlinfo.api.choosing">MySQL: scelta dell&apos;API</link>.
Le alternative a questa funzione includono:</simpara>'>

<!ENTITY mysql.alternative.note.4-3-0 '<simpara xmlns="http://docbook.org/ns/docbook">Questa funzione è stata deprecata in PHP 4.3.0, ed essa
e l&apos;intera <link linkend="book.mysql">estensione MySQL originale</link> sono state rimosse in PHP 7.0.0.
Al suo posto, usare l&apos;estensione <link linkend="book.mysqli">MySQLi</link> o <link linkend="ref.pdo-mysql">PDO_MySQL</link>, entrambe attivamente sviluppate.
Vedere anche la guida <link linkend="mysqlinfo.api.choosing">MySQL: scelta dell&apos;API</link>.
Le alternative a questa funzione includono:</simpara>'>

<!ENTITY mysql.alternative.note.5-3-0 '<simpara xmlns="http://docbook.org/ns/docbook">Questa funzione è stata deprecata in PHP 5.3.0, ed essa
e l&apos;intera <link linkend="book.mysql">estensione MySQL originale</link> sono state rimosse in PHP 7.0.0.
Al suo posto, usare l&apos;estensione <link linkend="book.mysqli">MySQLi</link> o <link linkend="ref.pdo-mysql">PDO_MySQL</link>, entrambe attivamente sviluppate.
Vedere anche la guida <link linkend="mysqlinfo.api.choosing">MySQL: scelta dell&apos;API</link>.
Le alternative a questa funzione includono:</simpara>'>

<!ENTITY mysql.alternative.note.5-4-0 '<simpara xmlns="http://docbook.org/ns/docbook">Questa funzione è stata deprecata in PHP 5.4.0, ed essa
e l&apos;intera <link linkend="book.mysql">estensione MySQL originale</link> sono state rimosse in PHP 7.0.0.
Al suo posto, usare l&apos;estensione <link linkend="book.mysqli">MySQLi</link> o <link linkend="ref.pdo-mysql">PDO_MySQL</link>, entrambe attivamente sviluppate.
Vedere anche la guida <link linkend="mysqlinfo.api.choosing">MySQL: scelta dell&apos;API</link>.
Le alternative a questa funzione includono:</simpara>'>

<!ENTITY mysql.close.connections.result.sets '<simpara xmlns="http://docbook.org/ns/docbook">
Le connessioni MySQL non persistenti aperte e i result set vengono distrutti automaticamente quando uno
script PHP termina la sua esecuzione. Quindi, sebbene chiudere esplicitamente le connessioni
aperte e liberare i result set sia facoltativo, è consigliato farlo.
Ciò restituirà immediatamente le risorse a PHP e MySQL, il che può
migliorare le prestazioni. Per informazioni correlate, vedere
<link linkend="language.types.resource.self-destruct">liberare le risorse</link></simpara>'>

<!-- Xattr entities -->
<!ENTITY xattr.namespace '<simpara xmlns="http://docbook.org/ns/docbook">Gli attributi estesi hanno due namespace differenti: user
e root. Il namespace user è disponibile per tutti gli utenti, mentre il namespace root
è disponibile solo per gli utenti con privilegi di root. xattr opera sul namespace user
per impostazione predefinita, ma questo si può cambiare con il parametro
<parameter>flags</parameter>.</simpara>'>

<!-- Notes for IPv6 -->
<!ENTITY ipv6.brackets '<note xmlns="http://docbook.org/ns/docbook"><simpara>Quando si specifica un indirizzo IPv6 numerico
(ad es. <literal>fe80::1</literal>), occorre racchiudere l&apos;IP tra parentesi
quadre, ad esempio <literal>tcp://[fe80::1]:80</literal>.</simpara></note>'>

<!-- Notes for tidy -->
<!ENTITY tidy.object 'L&apos;oggetto <classname xmlns="http://docbook.org/ns/docbook">Tidy</classname>.'>

<!-- Snippets for the installation section -->
<!ENTITY warn.install.third-party-support '<warning xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 <simpara>
  Le build di terze parti sono considerate non ufficiali e non direttamente
  supportate dal progetto PHP. Qualsiasi bug riscontrato dovrebbe essere segnalato al
  fornitore di tali build non ufficiali, a meno che non possa essere riprodotto usando le
  build della <link xlink:href="&url.php.downloads;">pagina di download
  ufficiale</link>.
 </simpara>
</warning>'>

<!ENTITY note.apache.slashes '<note xmlns="http://docbook.org/ns/docbook"><simpara>Ricordare che quando si aggiungono
valori di percorso nei file di configurazione di Apache su Windows, tutti i backslash
come <filename>c:\directory\file.ext</filename> devono essere convertiti in
slash: <filename>c:/directory/file.ext</filename>. Uno slash
finale può essere necessario anche per le directory.</simpara></note>'>

<!-- Snippets and titles for the contributors section -->
<!ENTITY Credit.Authors.and.Contributors 'Autori e Contributori'>

<!ENTITY Credit.Introduction '<simpara xmlns="http://docbook.org/ns/docbook"> C&apos;è un gran numero di contributori che
attualmente aiutano nel nostro lavoro o che hanno dato un grande aiuto al progetto
in passato. Ci sono anche molte persone non citate che aiutano con le loro
annotazioni sulle pagine del manuale, le quali vengono continuamente incluse nei riferimenti; anche del
loro lavoro siamo molto grati. Tutte le liste qui sotto sono in
ordine alfabetico.
</simpara>'>

<!ENTITY Credit.Authors.and.Editors 'Autori e Redattori'>

<!ENTITY Credit.Past.Authors.Text 'I seguenti contributori devono essere
riconosciuti per l&apos;impatto che hanno avuto e/o continuano ad avere aggiungendo
contenuti al manuale:'>

<!ENTITY Credit.Past.Editors.Text 'I seguenti contributori hanno svolto
un lavoro significativo di redazione del manuale:'>

<!ENTITY Credit.Note.Editors.Title 'Manutentori delle Note Utente'>

<!ENTITY Credit.Note.Editors.Active 'I manutentori attualmente più attivi sono:'>

<!ENTITY Credit.Note.Editors.Inactive 'Anche queste persone si sono impegnate molto
nella gestione delle note utente:'>

