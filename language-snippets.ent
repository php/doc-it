<!-- dba notes -->
<!ENTITY dba.parameter.dba 'Un&apos;istanza di <classname xmlns="http://docbook.org/ns/docbook">Dba\Connection</classname>, restituita da <function xmlns="http://docbook.org/ns/docbook">dba_open</function> o <function xmlns="http://docbook.org/ns/docbook">dba_popen</function>.'>
<!ENTITY dba.changelog.dba-object '<row xmlns="http://docbook.org/ns/docbook">
 <entry>8.4.0</entry>
 <entry>
  Il parametro <parameter>dba</parameter> ora si aspetta un&apos;istanza di <classname>Dba\Connection</classname>;
  in precedenza, era prevista una &resource; <literal>dba</literal> valida.
 </entry>
</row>'>

<!-- dbase notes -->

<!ENTITY dbase.type-conversion '<para xmlns="http://docbook.org/ns/docbook">
   Ogni campo viene convertito nel tipo PHP appropriato, eccetto:
   <itemizedlist>
    <listitem>
     <simpara>
      Le date vengono lasciate come stringhe.
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      I valori DateTime vengono convertiti in stringhe.
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      Gli interi al di fuori dell&apos;intervallo
      <constant>PHP_INT_MIN</constant>..<constant>PHP_INT_MAX</constant> vengono
      restituiti come stringhe.
     </simpara>
    </listitem>
    <listitem>
     <simpara>
      Prima di dbase 7.0.0, i booleani (<literal>L</literal>) venivano convertiti in <literal>1</literal> o
      <literal>0</literal>.
     </simpara>
    </listitem>
   </itemizedlist>
  </para>'>

