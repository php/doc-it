<appendix xml:id="network.constants" xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink">
 &reftitle.constants;
 &extension.constants.core;

 <variablelist>
  <title>
   Valori di <parameter>flags</parameter> disponibili per
   <function>openlog</function>
  </title>

  <varlistentry xml:id="constant.log-cons">
   <term>
    <constant>LOG_CONS</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Se si verifica un errore durante l'invio dei dati al logger di sistema,
     scrive direttamente sulla console di sistema.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-ndelay">
   <term>
    <constant>LOG_NDELAY</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Apre immediatamente la connessione al logger.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-odelay">
   <term>
    <constant>LOG_ODELAY</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Ritarda l'apertura della connessione fino a quando non viene registrato il primo messaggio.
     Questo è il comportamento predefinito.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-nowait">
   <term>
    <constant>LOG_NOWAIT</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-perror">
   <term>
    <constant>LOG_PERROR</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Registra i messaggi anche su <constant>STDERR</constant>.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-pid">
   <term>
    <constant>LOG_PID</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Include il PID in ciascun messaggio di log.
    </simpara>
   </listitem>
  </varlistentry>
 </variablelist>

 <variablelist>
  <title>
   Valori di <parameter>facility</parameter> disponibili per
   <function>openlog</function>
  </title>

  <varlistentry xml:id="constant.log-auth">
   <term>
    <constant>LOG_AUTH</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi di sicurezza/autorizzazione.
    </simpara>
    <note>
     <simpara>
      Usare invece <constant>LOG_AUTHPRIV</constant> quando disponibile.
     </simpara>
    </note>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-authpriv">
   <term>
    <constant>LOG_AUTHPRIV</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi di sicurezza/autorizzazione privati.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-cron">
   <term>
    <constant>LOG_CRON</constant>
    (<type>int</type>)
   </term>
   <listitem>
    <simpara>
     Per i messaggi del demone di clock.
     Ad esempio <command>cron</command> o <command>at</command>.
    </simpara>
   </listitem>
  </varlistentry>

  <varlistentry xml:id="constant.log-daemon">
   <term>
    <constant>LOG_DAEMON</constant>
